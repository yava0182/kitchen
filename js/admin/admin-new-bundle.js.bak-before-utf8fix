          }
          const info = document.getElementById('catalog-constructor-hinge-scheme-info');

          const schemeUi = _readHingeSchemeUi();
          if (!schemeUi.schemeId) {
            if (info) info.textContent = '\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0445\u0435\u043C\u0443 \u043F\u0435\u0442\u0435\u043B\u044C.';
