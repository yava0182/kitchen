    function normalizeCatalogDupField(value) {
      return String(value ?? '').trim().replace(/\s+/g, ' ').toLowerCase();
    }

    function findCatalogItemDuplicateLocal(items, { name, article, excludeId }) {
      const nName = normalizeCatalogDupField(name);
      const nArticle = normalizeCatalogDupField(article);
      const exId = excludeId != null ? Number(excludeId) : NaN;
      for (const it of Array.isArray(items) ? items : []) {
        if (!it || typeof it !== 'object') continue;
        const id = Number(it.id);
        if (isFinite(exId) && exId > 0 && id === exId) continue;
        const itName = normalizeCatalogDupField(it.name);
        const itArticle = normalizeCatalogDupField(getMatItemArticle(it));
        if (nArticle && itArticle === nArticle) {
          return { field: 'article', item: it };
        }
        if (nName && itName === nName && nArticle === itArticle) {
          return { field: 'name', item: it };
        }
      }
      return null;
    }

    async function fetchCatalogItemsList(typeKey) {
      if (!typeKey) return [];
      const resp = await fetch(`/api/catalog/items_get/${encodeURIComponent(typeKey)}?t=${Date.now()}`, { cache: 'no-cache' });
      if (!resp.ok) return [];
      const data = await resp.json();
      return normalizeItemsResponse(data);
    }

    function buildCatalogDuplicateAlert(kindLabel, duplicate, payload) {
      const existingId = duplicate?.item?.id;
      const existingName = duplicate?.item?.name || '';
      if (duplicate?.field === 'article') {
        const article = (payload?.article ?? '').toString().trim();
        return `${kindLabel} � ��������� �${article}� ��� ���������� (ID ${existingId}, �${existingName}�).`;
      }
      const name = (payload?.name ?? '').toString().trim();
      return `${kindLabel} �${name}� ��� ���������� (ID ${existingId}).`;
    }

    async function ensureNoCatalogItemDuplicate(typeKey, payload, excludeId, kindLabel) {
      let items = [];
      if (/^material_/i.test(typeKey) && materialsItemsState.type === typeKey && Array.isArray(materialsItemsState.allData) && materialsItemsState.allData.length) {
        items = materialsItemsState.allData;
      } else if (/^butt_/i.test(typeKey) && edgesItemsState.type === typeKey && Array.isArray(edgesItemsState.allData) && edgesItemsState.allData.length) {
        items = edgesItemsState.allData;
      } else {
        items = await fetchCatalogItemsList(typeKey);
      }
      const duplicate = findCatalogItemDuplicateLocal(items, {
        name: payload?.name,
        article: payload?.article,
        excludeId,
      });
      if (!duplicate) return true;
      alert(buildCatalogDuplicateAlert(kindLabel, duplicate, payload));
      return false;
    }

    function getMatItemArticle(item) {
      return (item?.article ?? item?.code ?? item?.vendor_code ?? '').toString();
