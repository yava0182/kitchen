          const activeContacts = activeIds.size
            ? contacts.filter((c) => activeIds.has(String(c.id)))
            : contacts.filter((c) => {
                const ck = String(c.groupKey || (c.seamAxis === 'y' ? 'vertical' : 'horizontal'));
                return ck === gKey || String(c.seamAxis || '') === String(g?.axis || '');
