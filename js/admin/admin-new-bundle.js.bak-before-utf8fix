                scale: { x: 1, y: 1, z: 1 },
                events: { on_before_params: '', on_before_build: '', on_after_build: '', on_drag_end: '' },
                accessories: [],
                comments: '',
                section_key: '',
                params_key: '',
              }
            : {};

          // === ����������� ������������ ����� ===
          // ������ �������� ����� id: "hinge_animator", ��� ���� (model/furniture/facade) � id: ""
          const normalizeHingeNode = () => {
            const origType = rawType;
            const kids = Array.from(nodeEl.querySelectorAll(':scope > .tree-node-children > .constructor-tree-node'));
            const isModelNode = (el) => {
              const t = String(el?.getAttribute('data-node-type') || '').toLowerCase();
              const ot = String(el?.getAttribute('data-original-type') || el?.nodeData?.originalType || '').toLowerCase();
              return t === 'model' || (t === 'detail' && ot === 'model');
            };
            const isFurnitureNode = (el) => {
              const t = String(el?.getAttribute('data-node-type') || '').toLowerCase();
              const ot = String(el?.getAttribute('data-original-type') || el?.nodeData?.originalType || '').toLowerCase();
              return t === 'furniture' || t === 'facade' || (t === 'detail' && (ot === 'furniture' || ot === 'facade'));
            };
            const hasModel = kids.some(el => isModelNode(el));
            const hasFurniture = kids.some(el => isFurnitureNode(el));
            const isFacadeAnimatorWithSiblingHingeModule = (() => {
              if (origType !== 'animator') return false;
              try {
                const hasFacadeChild = kids.some((el) => {
                  const t = String(el?.getAttribute('data-node-type') || '').toLowerCase();
                  const ot = String(el?.getAttribute('data-original-type') || el?.nodeData?.originalType || '').toLowerCase();
                  return t === 'facade' || (t === 'detail' && ot === 'facade');
                });
                if (!hasFacadeChild) return false;
                let sec = nodeEl.parentElement?.closest?.('.constructor-tree-node') || null;
                while (sec) {
                  const t = String(sec.getAttribute('data-original-type') || sec.nodeData?.originalType || sec.getAttribute('data-node-type') || '').toLowerCase();
                  if (t === 'section') break;
                  sec = sec.parentElement?.closest?.('.constructor-tree-node') || null;
                }
                if (!sec) return false;
                const wrap = sec.querySelector(':scope > .tree-node-children');
                if (!wrap) return false;
                const sk = Array.from(wrap.children).filter((el) => el.classList?.contains('constructor-tree-node'));
                return sk.some((el) => {
                  if (el === nodeEl) return false;
                  const ot = String(el.getAttribute('data-original-type') || el.nodeData?.originalType || '').toLowerCase();
                  return ot === 'module' && String(el.nodeData?.spec?.element_type || '').toLowerCase() === 'hinges';
                });
              } catch (_) {
                return false;
              }
            })();

            // ���: id hinge_animator ������ ��� �������� (����� / ������� �����).
            // ������ ����� ���� �|| hasModel�: ����� slide-���� � ��������� model ������� hinge_animator,
            // ��‑�� ���� ������ � ������ ��������� ���� � ��������� ������.
            const animFnSpec = String(nd?.spec?.fn || '').toLowerCase();
            const treatAsRotateHinge =
              animFnSpec === 'rotate' ||
              // ������ ������� ��� fn: ������������ ����� = model + furniture
              (animFnSpec === '' && hasModel && hasFurniture);
            if (origType === 'animator' && !isFacadeAnimatorWithSiblingHingeModule && treatAsRotateHinge) {
              nodeEl.setAttribute('data-node-id', 'hinge_animator');
              if (nd) nd.id = 'hinge_animator';
              return 'hinge_animator';
            }
            if ((origType === 'model' || origType === 'furniture' || origType === 'facade' || nodeType === 'section') && (hasHingeAncestorByStructure || hasHingeInSubtree)) {
              if (nd) nd.id = '';
              nodeEl.setAttribute('data-node-id', '');
              return '';
            }
            return null;
          };

          const normalizedHingeId = normalizeHingeNode();

          // (������������ ��� ��������� ���� � normalizeHingeNode)

          // �� ������ dataset.cldPath �� path ��������: ��� ������ � ���������
          // (���� ��������� / ������) path ������������� (�3� ������ �0,0,3�) �
          // ������ spawn ������ ����� (iframe ��� 0,0,0,3). ���� � ������ syncTreePaths().

          if (nodeType === 'section') {
            const secSpecRaw = nd.spec;
            const isCatalogLinkedSection =
              secSpecRaw && typeof secSpecRaw === 'object' && !Array.isArray(secSpecRaw)
              && String(secSpecRaw.element_type || '').trim()
              && String(secSpecRaw.id || '').trim();
            if (isCatalogLinkedSection) {
              const moduleSpec = { ...secSpecRaw };
              delete moduleSpec.template_tree;
              delete moduleSpec.templates;
              const sizeZ = nd.size?.z;
              const sizeZValue = (sizeZ === undefined || sizeZ === null || String(sizeZ).trim() === '')
