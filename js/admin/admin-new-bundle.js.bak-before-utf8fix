    // ---- 3D ������ ----
    let fb3dState = null;
    function fbDisposeObject3D(obj) {
      if (!obj) return;
      if (obj.children) {
        [...obj.children].forEach(fbDisposeObject3D);
      }
      if (obj.geometry) {
        try { obj.geometry.dispose(); } catch (_) {}
      }
      if (obj.material) {
        try {
          const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
          mats.forEach((m) => m?.dispose?.());
        } catch (_) {}
      }
    }

    function fbClearGroup(group) {
      if (!group) return;
      while (group.children.length) {
        const child = group.children[0];
        group.remove(child);
        fbDisposeObject3D(child);
      }
    }

    function fbInit3D() {
      const host = document.getElementById('fasteners-builder-preview-3d');
      if (!host || fb3dState) return;
      if (typeof THREE === 'undefined') return;
      const w = host.clientWidth || 200, h = host.clientHeight || 200;
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(w, h);
      renderer.setPixelRatio(window.devicePixelRatio);
      host.appendChild(renderer.domElement);
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(40, w / h, 0.1, 2000);
      camera.position.set(80, 60, 120);
      scene.add(new THREE.AmbientLight(0xffffff, 0.6));
      const dl = new THREE.DirectionalLight(0xffffff, 0.8);
      dl.position.set(50, 80, 60);
      scene.add(dl);
      let controls = null;
      if (typeof THREE.OrbitControls !== 'undefined') {
        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
      }
      const group = new THREE.Group();
      scene.add(group);
      fb3dState = { renderer, scene, camera, controls, group, host, rafId: 0 };
      function animate() {
        if (!fb3dState || fb3dState.renderer !== renderer) return;
        fb3dState.rafId = requestAnimationFrame(animate);
        if (controls) controls.update();
        renderer.render(scene, camera);
      }
      animate();
    }

    function fbDestroy3D() {
      if (!fb3dState) return;
      const { renderer, controls, group } = fb3dState;
      if (fb3dState.rafId) {
        cancelAnimationFrame(fb3dState.rafId);
        fb3dState.rafId = 0;
      }
      try { fbClearGroup(group); } catch (_) {}
      try { controls?.dispose?.(); } catch (_) {}
      try {
        const el = renderer?.domElement;
        if (el?.parentNode) el.parentNode.removeChild(el);
        renderer?.dispose?.();
      } catch (_) {}
      fb3dState = null;
    }

    window.addEventListener('pagehide', fbDestroy3D);
    window.addEventListener('beforeunload', fbDestroy3D);

    function fbUpdate3D(row, typeKey) {
      if (!fb3dState) fbInit3D();
      if (!fb3dState) return;
      const { group, camera } = fb3dState;
      fbClearGroup(group);
      const def = BM_FASTENER_TYPES[typeKey] || BM_FASTENER_TYPES.ties;
      const panelMat = new THREE.MeshPhongMaterial({ color: 0xd2b48c, transparent: true, opacity: 0.75 });
      const panel2Mat = new THREE.MeshPhongMaterial({ color: 0xc4a882, transparent: true, opacity: 0.75 });
      const holeMat = new THREE.MeshPhongMaterial({ color: 0x444444 });
      const fastMat = new THREE.MeshPhongMaterial({ color: 0x888888 });
      const TH = 16;
      if (def.layout === 'Tnail') {
        const vH = 52;
        const hW = 64;
        const pVert = new THREE.Mesh(new THREE.BoxGeometry(TH, vH, 36), panelMat);
        pVert.position.set(0, vH / 2 + TH / 2, 0);
        const pHoriz = new THREE.Mesh(new THREE.BoxGeometry(hW, TH, 36), panel2Mat);
        pHoriz.position.set(0, TH / 2, 0);
        group.add(pHoriz, pVert);
        const d = Math.max(row.d1 || row.d || 2, 1.5);
        const nailLen = Math.min(Math.max(row.h || 40, 24), 56);
        const nail = new THREE.Mesh(new THREE.CylinderGeometry(d / 2, d / 2, nailLen, 16), fastMat);
        nail.rotation.z = Math.PI / 2;
        nail.position.set(-nailLen / 2 + 2, TH + vH * 0.38, 0);
        group.add(nail);
        camera.position.set(55, 38, 72);
      } else if (def.layout === 'Ljoint') {
        const p1 = new THREE.Mesh(new THREE.BoxGeometry(TH, 60, 60), panelMat);
        p1.position.set(0, 0, 0);
        const p2 = new THREE.Mesh(new THREE.BoxGeometry(60, TH, 60), panel2Mat);
        p2.position.set(TH / 2 + 30, 0, 0);
        group.add(p1, p2);
        const d = Math.max(row.d || row.d1 || 5, 3);
        const edgeH = new THREE.Mesh(new THREE.CylinderGeometry(d / 2, d / 2, TH * 0.9, 16), holeMat);
        edgeH.rotation.z = Math.PI / 2;
        edgeH.position.set(0, 0, 0);
        group.add(edgeH);
        if (typeKey === 'ties' || typeKey === 'eurovinty' || typeKey === 'screws') {
          const d2 = Math.max(row.d2 || row.d || 5, 3);
          const faceH = new THREE.Mesh(new THREE.CylinderGeometry(d2 / 2, d2 / 2, TH * 0.9, 16), holeMat);
          faceH.position.set(TH / 2 + 20, 0, 0);
          group.add(faceH);
        }
        camera.position.set(60, 50, 100);
      } else if (def.layout === 'face2face') {
        const p1 = new THREE.Mesh(new THREE.BoxGeometry(80, TH, 60), panelMat);
        p1.position.set(0, TH / 2, 0);
        const p2 = new THREE.Mesh(new THREE.BoxGeometry(80, TH, 60), panel2Mat);
        p2.position.set(0, -TH / 2, 0);
        group.add(p1, p2);
        const d = Math.max(row.d1 || row.d || 2, 2);
        const nail = new THREE.Mesh(new THREE.CylinderGeometry(d / 2, d / 2, TH * 2, 16), fastMat);
        nail.position.set(0, 0, 0);
        group.add(nail);
        camera.position.set(80, 60, 100);
      } else if (def.layout === 'single') {
        const p = new THREE.Mesh(new THREE.BoxGeometry(60, TH, 60), panelMat);
        group.add(p);
        const d = Math.max(row.d || 5, 3);
        const depth = Math.min(row.h || TH, TH);
        const hMesh = new THREE.Mesh(new THREE.CylinderGeometry(d / 2, d / 2, depth, 16), holeMat);
        hMesh.position.set(0, TH / 2 - depth / 2, 0);
        group.add(hMesh);
        if (typeKey === 'knob_handles') {
          const knob = new THREE.Mesh(new THREE.CylinderGeometry(3, 5, 12, 16), fastMat);
          knob.position.set(0, TH / 2 + 6, 0);
          group.add(knob);
        } else if (typeKey === 'bar_handles') {
          const a = Math.max(row.a || 128, 40) * 0.3;
          const bar = new THREE.Mesh(new THREE.BoxGeometry(a, 3, 3), fastMat);
          bar.position.set(0, TH / 2 + 8, 0);
          group.add(bar);
          const leg1 = new THREE.Mesh(new THREE.CylinderGeometry(1.5, 1.5, 10, 8), fastMat);
          leg1.position.set(-a / 2, TH / 2 + 3, 0);
          group.add(leg1);
          const leg2 = new THREE.Mesh(new THREE.CylinderGeometry(1.5, 1.5, 10, 8), fastMat);
          leg2.position.set(a / 2, TH / 2 + 3, 0);
          group.add(leg2);
        }
        camera.position.set(60, 50, 90);
      } else if (def.layout === 'corner') {
        const p1 = new THREE.Mesh(new THREE.BoxGeometry(50, TH, 50), panelMat);
        const p2 = new THREE.Mesh(new THREE.BoxGeometry(TH, 50, 50), panel2Mat);
        p1.position.set(0, -25 + TH / 2, 0);
        p2.position.set(25 - TH / 2, 0, 0);
        group.add(p1, p2);
        const bracketMat = new THREE.MeshPhongMaterial({ color: 0xaaaaaa });
        const br1 = new THREE.Mesh(new THREE.BoxGeometry(20, 2, 20), bracketMat);
        br1.position.set(-4, -4, 0);
        group.add(br1);
        const br2 = new THREE.Mesh(new THREE.BoxGeometry(2, 20, 20), bracketMat);
        br2.position.set(6, 6, 0);
        group.add(br2);
        camera.position.set(70, 60, 100);
      } else if (def.layout === 'hinge') {
        const door = new THREE.Mesh(new THREE.BoxGeometry(TH, 70, 50), panelMat);
        door.position.set(0, 0, 0);
        const body = new THREE.Mesh(new THREE.BoxGeometry(50, TH, 50), panel2Mat);
        body.position.set(TH / 2 + 25, 20, 0);
        group.add(door, body);
        const cupR = Math.max(row.d || 26, 10) / 2;
        const cup = new THREE.Mesh(new THREE.CylinderGeometry(cupR, cupR, TH * 0.8, 24), holeMat);
        cup.rotation.z = Math.PI / 2;
        cup.position.set(0, 0, 0);
        group.add(cup);
        const arm = new THREE.Mesh(new THREE.BoxGeometry(30, 4, 10), fastMat);
        arm.position.set(TH / 2 + 15, 0, 0);
        group.add(arm);
        camera.position.set(70, 50, 100);
      } else {
        const p1 = new THREE.Mesh(new THREE.BoxGeometry(TH, 60, 60), panelMat);
        const p2 = new THREE.Mesh(new THREE.BoxGeometry(60, TH, 60), panel2Mat);
        p2.position.set(TH / 2 + 30, 0, 0);
        group.add(p1, p2);
        camera.position.set(60, 50, 100);
      }
      camera.lookAt(0, 0, 0);
    }

