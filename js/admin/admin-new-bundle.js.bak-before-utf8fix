              // ������ (������������, �����): ������ ����� + ����� ��� ������ � ������.
              // ����� � ��� volume (��� ������), ��� �� ����� ������� selectNode.
              helpers_visible: (isHingeAssemblyNode || isHingeContextNode) ? 0 : 1,
