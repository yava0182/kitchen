              }
            });
            if (flatItems.length) {
              setCatalog(flatItems);
              return;
            }
          }

          // 2) ���� ��� ��������� � ��������������
          if (Array.isArray(window.__CLD_ACCESSORIES_CATALOG) && window.__CLD_ACCESSORIES_CATALOG.length) {
            setCatalog(window.__CLD_ACCESSORIES_CATALOG);
            return;
