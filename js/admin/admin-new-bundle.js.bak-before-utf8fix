      const catById = {};
      categories.forEach((c) => {
        const id = String(c.id || '');
        if (id) catById[id] = c;
      });

      const getCatName = (id) => {
        const c = catById[id];
        if (!c) return id;
        return buildMaterialCategoryFullName(c, categories) || (c.name || id).toString();
      };

      const getTypeName = (key) => {
        const t = types[key];
