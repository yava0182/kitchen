      // ����� ����� ������: ���� �� types, � ���� ��� ����� � �� ������������ ���
      const typeKeysSet = new Set();
      Object.keys(types || {}).forEach((k) => typeKeysSet.add(String(k)));
      Object.keys(prices || {}).forEach((k) => typeKeysSet.add(String(k)));
      const typeKeys = Array.from(typeKeysSet).sort((a, b) => Number(a) - Number(b));

