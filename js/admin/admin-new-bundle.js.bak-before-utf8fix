    function loadDrillingTemplateEditPage() {
      const params = new URLSearchParams((window.location.hash || '').split('?')[1] || '');
      const id = Number(params.get('id') || '0');
      const arr = readDrills();
      let src = arr.find((x) => Number(x.id) === id) || null;
      // ���� id � URL �� ������ � ������ � ������������ ��������� ������������ ������.
      if (!src && id > 0) {
        const fallbackId = resolveExistingDrillEditId();
        if (fallbackId > 0) {
          src = arr.find((x) => Number(x.id) === fallbackId) || null;
          // ���� ������������ URL (��� return � ����� ����������� ����� ��).
          if (fallbackId !== id) {
            history.replaceState(null, '', `${window.location.pathname}#drilling-template-edit?id=${fallbackId}`);
          }
        }
      }
      const resolvedId = src ? Number(src.id) : id;
      if (resolvedId > 0 && src) saveLastDrillingEditId(resolvedId);
      // �������� ������������ ��� �������� ��������� � ��������, ����� �� ���������� ������ �������
      // IMPORTANT: ensureDrill already does deep clone inside. We rely on that + readDrills() returning fresh data.
      drillingEditSession.item = ensureDrill(src || { id: resolvedId });
      const item = drillingEditSession.item;
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = String(v ?? ''); };
