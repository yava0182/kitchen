    // ─── �������������� (shelf supports) ─────────────────────────────
    // Columns: D H Y  �  ONE drawing
    // Tall LEFT ����� (side panel face) + thin RIGHT ����� (shelf �����)
    // Shelf pin visible from side: enters LEFT panel's ����� hole
    function drawBM_shelf_supports(svg, row) {
      const pw = 46, ph = 128, hpW = 70, et = 36, vx = 28, vy = 38;
      const seamX = vx + pw;
      const vpY = vy + (ph - et) / 2;
      const edgeCy = vy + ph / 2;
      const dpx = 8, hpx = 20;
      let s = bmSvgDefs();
      s += bmPanel(vx, vy, pw, ph);          // LEFT: tall side
      s += bmPanel(seamX, vpY, hpW, et);     // RIGHT: thin shelf
      s += bmHoleCut(seamX - hpx, edgeCy - dpx, hpx, dpx * 2);
      s += bmBolt(seamX - hpx + 1, edgeCy - 3, hpx + 14, 6);
      // shelf-pin T-head visible in shelf
      s += `<rect x="${seamX + 1}" y="${edgeCy - 8}" width="14" height="16" fill="none" stroke="#111" stroke-width="0.7" rx="1"/>`;
      s += bmSeamLine(seamX, vy, seamX, vy + ph);
      s += bmCenterLine(vx - 6, edgeCy, seamX + hpW + 6, edgeCy);
      s += bmDimH(seamX - dpx * 2, seamX, vy + ph + 12, 'D', false);
      s += bmDimH(seamX, seamX + hpx, vy + ph + 26, 'H', false);
      s += bmDimV(vy, edgeCy - dpx, vx - 18, 'Y', true);
      const x0 = vx - 36, y0 = vy - 16, x1 = seamX + hpW + 16, y1 = vy + ph + 46;
      svg.setAttribute('viewBox', `${x0} ${y0} ${x1 - x0} ${y1 - y0}`);
      svg.innerHTML = s;
    }

    // ─── �����-������ (knob handles) ─────────────────────────────────
    // Columns: D D1  �  ONE drawing
    // Panel with bolt hole, knob disk visible above panel
    function drawBM_knob_handles(svg, row) {
      const pw = 110, ph = 60, vx = 40, vy = 58, D = 10, D1 = 34;
      const cx = vx + pw / 2;
      const holeH = Math.round(ph * 0.55);
      let s = bmSvgDefs();
      s += bmPanel(vx, vy, pw, ph);
      s += bmHoleCut(cx - D / 2, vy, D, holeH);
      s += bmBolt(cx - D / 2 + 1, vy + 1, D - 2, holeH - 2);
      // knob disk above panel
      s += `<ellipse cx="${cx}" cy="${vy - 14}" rx="${D1 / 2}" ry="11" fill="#ddd" stroke="#111" stroke-width="0.7"/>`;
      s += `<rect x="${cx - D / 2}" y="${vy - 3}" width="${D}" height="3" fill="#ccc" stroke="#111" stroke-width="0.4"/>`;
      s += bmCenterLine(cx, vy - 30, cx, vy + ph + 6);
      s += bmDimH(cx - D / 2, cx + D / 2, vy + ph + 12, 'D', false);
      s += bmDimH(cx - D1 / 2, cx + D1 / 2, vy - 30, 'D1', true);
      const x0 = vx - 18, y0 = vy - 42, x1 = vx + pw + 18, y1 = vy + ph + 28;
      svg.setAttribute('viewBox', `${x0} ${y0} ${x1 - x0} ${y1 - y0}`);
