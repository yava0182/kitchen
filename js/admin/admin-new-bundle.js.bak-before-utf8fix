        for (let p = Math.max(1, drillingListState.page - 2); p <= Math.min(totalPages, drillingListState.page + 2); p++) {
          html += `<li class="page-item ${p === drillingListState.page ? 'active' : ''}"><a class="page-link" href="#" data-p="${p}">${p}</a></li>`;
        }
        html += `<li class="page-item ${drillingListState.page === totalPages ? 'disabled' : ''}"><a class="page-link" href="#" data-p="${drillingListState.page + 1}">&gt;</a></li>`;
