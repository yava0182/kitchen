            }

            // ��������: �������� ������ � ������ � s:x/s:y/s:z. ���������: ������ ���� � nodeData �����.
            const lrRaw = nd.sectionLayoutRole ?? nd.layout_role;
            const layout_role =
              typeof window.__cldNormalizeSectionLayoutRole === 'function'
                ? window.__cldNormalizeSectionLayoutRole(lrRaw)
