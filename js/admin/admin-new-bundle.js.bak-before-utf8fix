    function expandEdgeCatalogRowsForPicker(items) {
      const rows = [];
      const list = Array.isArray(items) ? items : [];
      for (const item of list) {
        const variants = getEdgeVariantsFromCatalogItem(item);
        if (variants.length <= 1) {
          rows.push({ item, variantIndex: 0, variant: variants[0] || null });
          continue;
        }
        variants.forEach((variant, variantIndex) => {
          rows.push({ item, variantIndex, variant });
        });
      }
      return rows;
    }

    function edgePickerRowDisplayName(item, variant, variantIndex) {
      const base = (variant?.name || item?.name || '').toString().trim() || ('ID ' + (item?.id ?? ''));
