                const a = nd.anchor && typeof nd.anchor === 'object' ? nd.anchor : {};
                return {
                  x: a.x !== undefined && a.x !== null ? toNumOrExpr(a.x, def.x) : def.x,
                  y: a.y !== undefined && a.y !== null ? toNumOrExpr(a.y, def.y) : def.y,
