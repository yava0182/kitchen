        // ��� ��������� ��������� ���������� �� ������������ ��������� ������.
        let cats = [];
        const localResp = await fetch('/api/catalog/categories_get/facades?t=' + Date.now(), { cache: 'no-cache' });
        if (localResp.ok) {
          const localData = await localResp.json();
          cats = Array.isArray(localData) ? localData : (Array.isArray(localData?.items) ? localData.items : []);
        }

        // Fallback (���� ��������� ��������� ���) � ������ �������� �� ���������.
        if (!cats.length) {
          const resp = await fetch('/api/facades?t=' + Date.now(), { cache: 'no-cache' });
