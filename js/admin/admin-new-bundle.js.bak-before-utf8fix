        function _jointContactAxisForTreeNode(node, jointIdx) {
          const o = String(node?.nodeData?.spec?.orientation || node?.nodeData?.orientation || '').toLowerCase();
          const j = Number(jointIdx);
          if (o === 'v') {
            if (j === 0 || j === 1) return 'y';
            if (j === 2 || j === 3) return 'z';
          } else if (o === 'h') {
            if (j === 0 || j === 1) return 'x';
            if (j === 2 || j === 3) return 'z';
          } else if (o === 'f') {
            if (j === 0 || j === 1) return 'y';
            if (j === 2 || j === 3) return 'x';
          }
          return '';
        }

        /**
         * ���������� jointIdx ��� ������ �����:
         * hostJointIdx 0..3 ���� ��������, ����� ��������� 100+ �� contactId.
         */
        function _stableJointIdxForContact(c, used) {
          const set = used instanceof Set ? used : new Set();
          const hj = Number(c?.hostJointIdx);
          if (Number.isFinite(hj) && hj >= 0 && hj <= 3 && !set.has(hj)) {
            set.add(hj);
            return hj;
          }
          let h = 0;
          const s = String(c?.id || c?.contactId || '');
          for (let i = 0; i < s.length; i++) h = ((h * 31) + s.charCodeAt(i)) | 0;
          let syn = 100 + (Math.abs(h) % 800);
          while (set.has(syn)) syn += 1;
          set.add(syn);
          return syn;
        }

        function _jointEntryLabel(j) {
          if (j?.neighborName) return String(j.neighborName);
          const n = JOINT_NAMES[Number(j?.jointIdx)];
