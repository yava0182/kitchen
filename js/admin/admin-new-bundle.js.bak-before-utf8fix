        /** ��� ������ �����↔������ �� iframe + ������ �� ���. */
        let _jointSeamContactsCache = [];
        let _jointSeamGroupsCache = [];

        function _querySeamContactsFromIframe(node) {
          return new Promise((resolve) => {
            if (typeof __ppPreviewIframe === 'undefined' || !__ppPreviewIframe?.contentWindow) {
              resolve({ contacts: [], groups: [] });
              return;
            }
            const reqId = 'seam_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);
            const domPath = (typeof getNodePath === 'function' ? getNodePath(node) : null) ?? '';
            const nodePath = (typeof domPathToIframePath === 'function' ? domPathToIframePath(domPath) : domPath) || '';
            let done = false;
            const finish = (payload) => {
              if (done) return;
              done = true;
              window.removeEventListener('message', onMsg);
              resolve({
                contacts: Array.isArray(payload?.contacts) ? payload.contacts : [],
                groups: Array.isArray(payload?.groups) ? payload.groups : [],
              });
            };
            const onMsg = (ev) => {
              const d = ev?.data;
              if (!d || d.type !== 'cld:seamContacts' || d.reqId !== reqId) return;
              finish(d);
            };
            window.addEventListener('message', onMsg);
            try {
              __ppPreviewIframe.contentWindow.postMessage(
                { type: 'cld:querySeamContacts', reqId, nodePath },
                '*',
              );
            } catch (_) {
              finish({});
              return;
            }
            window.setTimeout(() => finish({}), 2000);
          });
        }

        function _normalizeSeamGroups(contacts, groupsFromIframe) {
          const list = Array.isArray(groupsFromIframe) ? groupsFromIframe : [];
          if (list.length && list.some((g) => g && g.key && (g.contactIds || []).length)) {
            return list.map((g) => ({
              key: String(g.key || ''),
              axis: g.axis || (String(g.key).includes('vertical') ? 'y' : 'horizontal'),
              name: g.name || String(g.key || ''),
              count: Number(g.count) || (g.contactIds || []).length || 0,
              contactIds: Array.isArray(g.contactIds) ? g.contactIds : [],
              slots: Array.isArray(g.slots) ? g.slots : [],
              hostFaceType: g.hostFaceType || null,
            }));
          }
          // �������: ������� = ���� ����� � ��� (������������ ����� �����������).
          const buckets = new Map();
          for (const c of contacts || []) {
            const face = String(c.hostFaceType || 'torets') === 'plast' ? 'plast' : 'torets';
            const orient =
              c.groupKey === 'horizontal' ||
              (c.seamAxis && String(c.seamAxis).toLowerCase() !== 'y')
                ? 'horizontal'
                : 'vertical';
            const key = `${face}_${orient}`;
            if (!buckets.has(key)) buckets.set(key, []);
            buckets.get(key).push(c);
          }
          const order = [
            'torets_vertical',
            'torets_horizontal',
            'plast_vertical',
            'plast_horizontal',
          ];
          const titleOf = {
            torets_vertical: '����� � ���������',
            torets_horizontal: '����� � �����������',
            plast_vertical: '������ � ���������',
            plast_horizontal: '������ � �����������',
          };
          const out = [];
          for (const key of order) {
            const items = buckets.get(key);
            if (!items?.length) continue;
            const neighbors = [...new Set(items.map((c) => c.neighborName).filter(Boolean))];
            out.push({
              key,
              axis: key.endsWith('vertical') ? 'y' : 'horizontal',
              name: (titleOf[key] || key) + (neighbors.length ? (` � ${neighbors.join(', ')}`) : ''),
              count: items.length,
              contactIds: items.map((c) => c.id),
              slots: [...new Set(
                items.map((c) => Number(c.hostJointIdx)).filter((n) => Number.isFinite(n) && n >= 0),
              )],
              hostFaceType: key.startsWith('plast') ? 'plast' : 'torets',
            });
          }
          return out;
        }

