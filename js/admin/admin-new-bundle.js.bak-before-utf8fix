    const DRILL_SCHEMES_KEY = 'clodis_drill_schemes_v1';

    function readSchemes() {
      try { return JSON.parse(localStorage.getItem(DRILL_SCHEMES_KEY) || '[]'); } catch { return []; }
    }
    function saveSchemes(arr) {
      try {
        localStorage.setItem(DRILL_SCHEMES_KEY, JSON.stringify(arr));
        if (typeof window.__cldScheduleDrillLibraryExport === 'function') window.__cldScheduleDrillLibraryExport();
      } catch(e) { console.error(e); }
    }
    function nextSchemeId(arr) {
      return arr.reduce((mx, x) => Math.max(mx, Number(x.id) || 0), 0) + 1;
    }
    function ensureScheme(obj) {
      obj = obj || {};
      return {
        id: Number(obj.id) || 0,
        name: String(obj.name || '����� �����'),
        article: String(obj.article || ''),
        templateId: Number(obj.templateId) || 0,
        cabinetModelId: Number(obj.cabinetModelId) || 0,
        cabinetModelName: String(obj.cabinetModelName || ''),
        schemeType: ['from_base','symmetric','variable'].includes(obj.schemeType) ? obj.schemeType : 'from_base',
        // �����: back = ������� ������ (��� � ������), front = ��������������� ����� ���.
        base: obj.base === 'front' ? 'front' : 'back',
        offsetFromBase: Number(obj.offsetFromBase) >= 0 ? Number(obj.offsetFromBase) : 50,
        step: Number(obj.step) > 0 ? Number(obj.step) : 32,
        minOffsetOpposite: Number(obj.minOffsetOpposite) >= 0 ? Number(obj.minOffsetOpposite) : 32,
        /** �����: ���. ������ ����� (��). 0 = ������� �� � ��������� �������. */
        minSeamWidthMm: Number(obj.minSeamWidthMm) >= 0 ? Number(obj.minSeamWidthMm) : 0,
        symOffset: Number(obj.symOffset) >= 0 ? Number(obj.symOffset) : 50,
        symStep: Number(obj.symStep) > 0 ? Number(obj.symStep) : 32,
        countRules: Array.isArray(obj.countRules) ? obj.countRules.map(r => ({
          from: Number(r.from) || 0,
          to: Number(r.to) || 0,
          count: Math.max(1, Number(r.count) || 1)
        })) : []
      };
    }

    /**
     * ��������� ���������� (from-base-forced): ������� ����� ���������� (off �� ����),
     * ������� ����� � ������������ ��� �� ��������, �� ����� minOpp � ���������������� ����.
     * ��� N≥3 � ���������� ����� lo � hi. ���: 0 = �����/���, seamLen = �����.
     */
    function fromBaseForcedSpreadPositions(seamLen, forcedCount, fromPivot, off, minOpp, stepMm) {
      const step = Number(stepMm) > 0 ? Number(stepMm) : 32;
      const n = forcedCount;
      if (n <= 0) return [];
      let lo;
      let hi;
      if (fromPivot) {
        lo = off;
        const maxHi = seamLen - minOpp;
        hi = lo + Math.floor((maxHi - lo) / step) * step;
      } else {
        hi = seamLen - off;
        lo = hi - Math.floor((hi - minOpp) / step) * step;
      }
      if (hi < lo - 0.01) {
        return n >= 1 ? [seamLen / 2] : [];
      }
      if (n === 1) return [seamLen / 2];
      if (n === 2) return lo <= hi ? [lo, hi] : [hi, lo];
      const gap = (hi - lo) / (n - 1);
      return Array.from({ length: n }, (_, i) => lo + i * gap);
    }

    /**
     * ������������ ������� ������� ����� �����.
     * @param {object} scheme - ������ �����
     * @param {number} seamLen - ����� ����� (��)
     * @returns {{ positions: number[], count: number, mode: string }}
     */
    function calcSchemePositions(scheme, seamLen) {
      if (!scheme || seamLen <= 0) return { positions: [], count: 0, mode: '' };

      // 1. ���������� ������ ���������� �� �������
      let forcedCount = 0;
      const rules = (scheme.countRules || [])
        .slice()
        .sort((a, b) => a.from - b.from);
      for (const rule of rules) {
        if (seamLen >= rule.from && seamLen <= rule.to) {
          forcedCount = rule.count;
          break;
        }
      }

      if (scheme.schemeType === 'symmetric') {
        const off = scheme.symOffset;
        if (forcedCount > 0) {
          const positions = [];
          if (forcedCount === 1) {
            positions.push(seamLen / 2);
          } else {
            const gap = (seamLen - 2 * off) / (forcedCount - 1);
            for (let i = 0; i < forcedCount; i++) positions.push(off + i * gap);
          }
          return { positions, count: positions.length, mode: 'symmetric-forced' };
        }
        // ��� �������: ������ ������������ ������� ����� �������.
        // ���������� ����� ���������� ������ ����� countRules � ���������� ����� ���������� �������.
        if (seamLen - 2 * off <= 0) return { positions: [seamLen / 2], count: 1, mode: 'symmetric-center' };
        return { positions: [off, seamLen - off], count: 2, mode: 'symmetric-2' };
      }

      // from_base / variable � ���������� � �� ����� ���: 0 � ������ (��� ������), seamLen � �������.
      // base: 'back' � ������ offsetFromBase �� ������; minOffsetOpposite � �� ����� � ������.
      // base: 'front' � ������ �� ��������� ����� ���; minOffsetOpposite � �� ����� � ������.
      const off = scheme.offsetFromBase;
      const step = scheme.step;
      const minOpp = scheme.minOffsetOpposite;
      const maxPos = seamLen - minOpp;
      const minPos = minOpp;
      const fromPivot = String(scheme.base || 'back').toLowerCase() !== 'front';

      if (forcedCount > 0) {
        const positions = fromBaseForcedSpreadPositions(seamLen, forcedCount, fromPivot, off, minOpp, step);
        return { positions, count: positions.length, mode: 'from-base-forced' };
      }

      const positions = [];
      if (fromPivot) {
        let pos = off;
        while (pos <= maxPos + 0.01) {
          positions.push(pos);
          pos += step;
        }
      } else {
        let pos = seamLen - off;
        while (pos >= minPos - 0.01) {
          positions.push(pos);
          pos -= step;
        }
        positions.sort((a, b) => a - b);
      }
      return { positions, count: positions.length, mode: 'from-base' };
    }

