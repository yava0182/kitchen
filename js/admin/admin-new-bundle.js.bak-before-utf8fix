    // ─── �����-����� (bar handles) ────────────────────────────────────
    // Columns: D D1 A  �  ONE drawing
    // Panel with 2 through holes, U-shaped bar visible below
    function drawBM_bar_handles(svg, row) {
      const pw = 220, ph = 40, vx = 30, vy = 52, D = 8, D1 = 8, A = 128;
      const cx1 = vx + (pw - A) / 2, cx2 = cx1 + A, barH = 22;
      let s = bmSvgDefs();
      s += bmPanel(vx, vy, pw, ph);
      s += bmHoleCut(cx1 - D / 2, vy, D, ph);
      s += bmHoleCut(cx2 - D1 / 2, vy, D1, ph);
      // U-bar below panel
      const by = vy + ph;
      s += `<path d="M${cx1},${by} L${cx1},${by + barH} Q${(cx1 + cx2) / 2},${by + barH + 10} ${cx2},${by + barH} L${cx2},${by}" fill="none" stroke="#111" stroke-width="0.9"/>`;
      s += bmCenterLine(cx1, vy - 8, cx1, by + barH + 14);
      s += bmCenterLine(cx2, vy - 8, cx2, by + barH + 14);
      s += bmDimH(cx1 - D / 2, cx1 + D / 2, vy - 14, 'D', true);
      s += bmDimH(cx2 - D1 / 2, cx2 + D1 / 2, vy - 14, 'D1', true);
      s += bmDimH(cx1, cx2, vy - 28, 'A', true);
      const x0 = vx - 14, y0 = vy - 40, x1 = vx + pw + 14, y1 = by + barH + 28;
      svg.setAttribute('viewBox', `${x0} ${y0} ${x1 - x0} ${y1 - y0}`);
      svg.innerHTML = s;
    }

    // ─── ��������� (pushers) ──────────────────────────────────────────
    // Columns: D H  �  ONE drawing (like blind hole, rectangular cavity)
    function drawBM_pushers(svg, row) {
      const pw = 110, ph = 68, vx = 40, vy = 40, D = 22, H = 28;
      const cx = vx + pw / 2;
      let s = bmSvgDefs();
      s += bmPanel(vx, vy, pw, ph);
      s += bmHoleCut(cx - D / 2, vy, D, H);
      // pusher body (gray square)
      s += `<rect x="${cx - D / 2 + 1}" y="${vy + 1}" width="${D - 2}" height="${H - 2}" fill="#999" stroke="#111" stroke-width="0.3"/>`;
      s += bmCenterLine(cx, vy - 8, cx, vy + ph + 8);
      s += bmDimH(cx - D / 2, cx + D / 2, vy - 12, 'D', true);
      s += bmDimV(vy, vy + H, vx + pw + 14, 'H', false);
      svg.setAttribute('viewBox', `${vx - 18} ${vy - 28} ${pw + 52} ${ph + 44}`);
      svg.innerHTML = s;
    }

    // ─── ����� (hinges) ───────────────────────────────────────────────
    // Columns: D H Y D1 H1 Y1 A1 D2 H2 A2 X1 X2 X3 D3 H3
    // RIGHT drawing: panel face with large hinge cup + mounting hole
    // Dims: D (cup diameter), H (cup depth), D1 (mounting hole diam), Y (from top to cup), Y1 (cup→mounting)
    function drawBM_hinges(svg, row) {
      const pw = 80, ph = 130, vx = 28, vy = 36;
      const cupR = 18, cupH = 13, scrR = 4;
      const cx = vx + pw / 2;
      const cupCy = vy + 44;        // cup center Y
      const scrCy = cupCy + 36;    // mounting screw Y
      let s = bmSvgDefs();
      s += bmPanel(vx, vy, pw, ph);
      // Hinge cup: circle + depth cut at top
      s += bmCircleHole(cx, cupCy, cupR);
      s += bmHoleCut(cx - cupR, vy, cupR * 2, cupH);
      // Mounting screw hole
      s += bmCircleHole(cx, scrCy, scrR);
      s += bmCenterLine(cx, vy - 8, cx, vy + ph + 8);
      s += bmCenterLine(vx - 8, cupCy, vx + pw + 8, cupCy);
      s += bmCenterLine(vx - 8, scrCy, vx + pw + 8, scrCy);
      // Dims
      s += bmDimH(cx - cupR, cx + cupR, vy - 14, 'D', true);
      s += bmDimV(vy, vy + cupH, vx + pw + 14, 'H', false);
      s += bmDimV(vy, cupCy, vx - 16, 'Y', true);
      s += bmDimV(cupCy, scrCy, vx + pw + 28, 'Y1', false);
      s += bmDimH(cx - scrR, cx + scrR, scrCy + scrR + 12, 'D1', false);
      const x0 = vx - 34, y0 = vy - 26, x1 = vx + pw + 46, y1 = vy + ph + 14;
      svg.setAttribute('viewBox', `${x0} ${y0} ${x1 - x0} ${y1 - y0}`);
      svg.innerHTML = s;
    }

    // ─── ������ (corners) ─────────────────────────────────────────────
    // RIGHT drawing: L-joint cross-section + bracket + hole D depth H
    // Origin point 0 at seam corner
    function drawBM_corners(svg, row) {
      const pw = 46, ph = 128, hpW = 70, et = 36, vx = 28, vy = 38;
      const seamX = vx + pw;
      const vpY = vy + (ph - et) / 2;
      const edgeCy = vy + ph / 2;
      const bw = 18, bh = 30;
      const bx = seamX - bw / 2, by = edgeCy - bh;
      let s = bmSvgDefs();
      s += bmPanel(vx, vy, pw, ph);
      s += bmPanel(seamX, vpY, hpW, et);
      s += bmSeamLine(seamX, vy, seamX, vy + ph);
      // Corner bracket (L-bracket outline)
      s += `<path d="M${bx},${by + bh} L${bx},${by} L${bx + bw},${by} L${bx + bw},${by + bh}" fill="none" stroke="#111" stroke-width="0.9"/>`;
      // Screw holes in bracket
      s += bmCircleHole(seamX - 9, by + bh * 0.3, 3);
      s += bmCircleHole(seamX + 9, by + bh * 0.7, 3);
      // Origin marker (red dot)
      s += `<circle cx="${seamX}" cy="${edgeCy}" r="2.5" fill="#c00"/>`;
      s += `<text x="${seamX + 4}" y="${edgeCy - 4}" font-size="9" fill="#c00" font-weight="bold">0</text>`;
      s += bmCenterLine(seamX, vy - 8, seamX, vy + ph + 8);
      s += bmDimH(seamX, seamX + 14, vpY + et + 14, 'D', false);
      s += bmDimV(by, by + bh, seamX + hpW + 14, 'H', false);
      const x0 = vx - 16, y0 = vy - 16, x1 = seamX + hpW + 34, y1 = vpY + et + 36;
      svg.setAttribute('viewBox', `${x0} ${y0} ${x1 - x0} ${y1 - y0}`);
      svg.innerHTML = s;
    }

