    function __cldResolveFacadeThicknessMmForClodis(item) {
      try {
        const rootEl = document.getElementById('constructor-root-module');
        const fromRoot = Number(rootEl?.nodeData?.variables?.main?.facade_thickness_mm);
        if (Number.isFinite(fromRoot) && fromRoot > 0) return fromRoot;
      } catch (_) {}
      try {
        const hid = Number(item?.hingeLayoutId);
        if (Number.isFinite(hid) && hid > 0) {
          const hit = readHingeLayoutSchemes().find((s) => Number(s.id) === hid);
          if (hit) {
            const t = Number(ensureHingeLayoutScheme(hit).facadeThickness);
            if (Number.isFinite(t) && t > 0) return t;
