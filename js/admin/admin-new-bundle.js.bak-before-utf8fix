        const hasClipboard = () => {
          try { return !!localStorage.getItem(CLIP_KEY); } catch { return false; }
        };

        const setPasteEnabled = () => {
          if (!mPaste) return;
          const ok = hasClipboard();
          if (ok) {
            mPaste.classList.remove('disabled');
            mPaste.style.cursor = 'pointer';
            mPaste.style.opacity = '1';
