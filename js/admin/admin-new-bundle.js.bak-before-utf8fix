        const openVarModal = ({ mode, groupId, scope, varId } = {}) => {
          const nd = getRootNodeData();
          if (!nd || !varModal) return;
          const gid = groupId || getSelectedGroupId();

          varMode.value = mode || 'add';
          varGroupId.value = gid || '';
