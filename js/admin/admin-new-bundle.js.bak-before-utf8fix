        /**
         * ����� ��� � ���-JSON PlanPlace + joint-panel-local.buildSetup3FurnitureAnchor:
         * ����� ��� v: x=8 (half), ���� y=s:y+16 rot.z=90, ��� y=-16 rot.z=-90, z=���.
         */
        function _buildRefFurnitureAnchorPose(detailNode, jointIdx, seamPosMm) {
          const dims = _jointPanelLocalParentSizeMm(detailNode);
          const o = dims.o;
          const thick = dims.thick;
          const half = thick / 2;
          const sx = dims.x;
          const sy = dims.y;
          const j = Number(jointIdx);
          const seamKey = String(_jointSeamSizeKey(j, detailNode) || 'z').toLowerCase();
          const posMm = { x: half, y: 0, z: 0 };
          const rotDeg = { x: 0, y: 0, z: 0 };

          if (o === 'v') {
            posMm.x = half;
            if (j === 0) {
              posMm.y = sy + thick;
              rotDeg.z = 90;
            } else if (j === 1) {
              posMm.y = -thick;
              rotDeg.z = -90;
            } else if (j === 2) {
              posMm.x = -thick;
              posMm.y = sy / 2;
              rotDeg.z = 0;
            } else if (j === 3) {
              posMm.x = sx + thick;
              posMm.y = sy / 2;
              rotDeg.z = 180;
            }
          } else if (o === 'h') {
            // ��� �� � ����: pos x=���, y=s:y+16, z=50, rot.z=90
            posMm.y = half;
            if (j === 0) {
              posMm.y = sy + thick;
              rotDeg.z = 90;
            } else if (j === 1) {
              posMm.y = -thick;
              rotDeg.z = -90;
            } else if (j === 2) {
              posMm.x = half;
              rotDeg.y = 90;
            } else if (j === 3) {
              posMm.x = Math.max(0, sx - half);
              rotDeg.y = -90;
            }
          } else {
            posMm.z = half;
            if (j === 2) {
              posMm.x = -thick;
              rotDeg.z = 0;
            } else if (j === 3) {
              posMm.x = sx + thick;
              rotDeg.x = 180;
              rotDeg.z = -180;
            } else if (j === 0) {
              posMm.y = sy + thick;
              rotDeg.z = 90;
            } else {
              posMm.y = -thick;
              rotDeg.z = -90;
            }
          }

          if (seamKey === 'x' || seamKey === 'y' || seamKey === 'z') {
            posMm[seamKey] = Math.round(Number(seamPosMm) || 0);
          }

          return {
            pos: {
              x: Math.round((Number(posMm.x) || 0) * 100) / 100,
              y: Math.round((Number(posMm.y) || 0) * 100) / 100,
              z: Math.round((Number(posMm.z) || 0) * 100) / 100,
            },
            rot: rotDeg,
            pivot: { x: -1, y: -1, z: -1 },
          };
        }

