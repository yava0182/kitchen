    function calcHingeLayoutPositions(layout, facadeH) {
      const topOffset = Math.max(0, Number(layout.topOffset) || 0);
      const bottomOffset = Math.max(0, Number(layout.bottomOffset) || 0);
      const middleStep = Math.max(1, Number(layout.middleStep) || 450);
      const minCount = Math.max(2, Math.round(Number(layout.minCount) || 2));
      const threeThreshold = Math.max(300, Number(layout.threeThreshold) || 900);
      const H = Math.max(1, Number(facadeH) || 500);
      let count = Math.max(2, minCount);
      if (H >= threeThreshold) count = Math.max(count, 3);
      const byStep = Math.floor(Math.max(0, H - topOffset - bottomOffset) / middleStep) + 2;
      count = Math.max(count, byStep);
      const yTop = Math.max(0, topOffset);
      const yBottom = Math.max(yTop + 1, H - bottomOffset);
      if (count <= 2) return [yTop, yBottom];
      return Array.from({ length: count }, (_, i) => {
        const t = i / (count - 1);
        return Math.round(yTop + (yBottom - yTop) * t);
      });
    }


