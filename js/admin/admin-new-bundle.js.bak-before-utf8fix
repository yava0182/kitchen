        /** ������� ������� �� ����� (��� ���������� � ������). */
        function _enrichJointEntry(j, allSchemes, domNode) {
          const sid = Number(j.schemeId);
          const sch = allSchemes.find(s => Number(s.id) === sid);
          let seam = Number(j.seamLen) || 0;
          if (!(seam > 0) && Number(j.seamOverlapMm) > 0) seam = Number(j.seamOverlapMm);
          let seamSizeKey = String(j.seamSizeKey || '').trim();
          // ������� �����↔������: ����� ���� ������ � �����. �� ��������� ��������� ������
          // (����� synthetic jointIdx ������ → seamLen=600 � ����� �� �������).
          const isContactSeam = !!(j.contactId || j.neighborName || j.conditionKey);
          if (!isContactSeam && domNode && domNode.nodeData) {
            const sk = _jointSeamSizeKey(Number(j.jointIdx), domNode);
            seamSizeKey = sk;
            const resolved = _resolveSeamLenMm(sk, domNode);
            if (Number.isFinite(resolved) && resolved > 0) seam = resolved;
          } else if (!isContactSeam && !seamSizeKey && domNode && Number.isFinite(Number(j.jointIdx)) && Number(j.jointIdx) >= 0 && Number(j.jointIdx) <= 3) {
            seamSizeKey = _jointSeamSizeKey(Number(j.jointIdx), domNode);
          }
          const res = sch && seam > 0 ? calcSchemePositions(sch, seam) : null;
          const tplId = Number(sch?.templateId) || 0;
          const tpl = tplId && typeof readDrills === 'function'
            ? readDrills().find((t) => Number(t.id) === tplId)
            : null;
          const cmId =
            Number(tpl?.cabinetModelId) ||
            Number(j.cabinetModelId) ||
            Number(sch?.cabinetModelId) ||
            0;
          const out = {
            ...j,
            schemeId: sid,
            seamLen: seam,
            seamSizeKey: seamSizeKey || j.seamSizeKey,
            positions: res?.positions || [],
            count: res?.count || 0,
          };
          if (cmId > 0) out.cabinetModelId = cmId;
          if (!sch) console.warn('[CLD-JOINT][admin] ����� �� ������� �� id=', j.schemeId, '������� id:', (allSchemes || []).map(s => s.id));
          else if (!out.positions.length) console.warn('[CLD-JOINT][admin] ��� ������� (��������� seamLen � �����)', { jointIdx: j.jointIdx, contactId: j.contactId, schemeId: sid, seamLen: seam, schemeName: sch.name });
          return out;
        }

        function _panelThicknessSizeKey(orientation) {
          const o = String(orientation || '').toLowerCase();
          if (o === 'v') return 'x';
          if (o === 'f') return 'z';
          return 'y';
        }

        /**
         * ������� ������ � �� (���. buildWall / v:_wt), �� size.x ��� s:x � ���������.
         * ����� half=300 � ������ ������������� ������� �����.
         */
        function _panelThicknessMmAdmin(detailNode) {
          const nd = detailNode?.nodeData || {};
          const direct = [
            nd.spec?.thickness_mm,
            nd.thickness_mm,
            nd.spec?.thickness,
            nd.spec?.material?.thickness,
          ].map(Number);
          for (const t of direct) {
            if (Number.isFinite(t) && t > 0 && t <= 64) return t;
          }
          const o = String(nd.spec?.orientation || nd.orientation || '').toLowerCase();
          const sx = _resolveSeamLenMm('x', detailNode);
          const sy = _resolveSeamLenMm('y', detailNode);
          const sz = _resolveSeamLenMm('z', detailNode);
          if (o === 'v' && sx > 0 && sx <= 64) return sx;
          if (o === 'h' && sy > 0 && sy <= 64) return sy;
          if (o === 'f' && sz > 0 && sz <= 64) return sz;
          const thin = [sx, sy, sz].filter((n) => Number.isFinite(n) && n > 0 && n <= 64);
          if (thin.length) return Math.min(...thin);
          return 16;
        }

        /**
         * parent_size �� � ������ ������ (��� panelParentSizeMm � joint-panel-local):
         * v → thickness � height � depth.
         */
        function _jointPanelLocalParentSizeMm(detailNode) {
          const o = String(
            detailNode?.nodeData?.spec?.orientation || detailNode?.nodeData?.orientation || 'h'
          ).toLowerCase();
          const thick = _panelThicknessMmAdmin(detailNode);
          if (o === 'v') {
            return {
              x: thick,
              y: Math.max(1, _resolveSeamLenMm('y', detailNode)),
              z: Math.max(1, _resolveSeamLenMm('z', detailNode)),
              thick,
              o,
            };
          }
          if (o === 'h') {
            return {
              x: Math.max(1, _resolveSeamLenMm('x', detailNode)),
              y: thick,
              z: Math.max(1, _resolveSeamLenMm('z', detailNode)),
              thick,
              o,
            };
          }
          return {
            x: Math.max(1, _resolveSeamLenMm('x', detailNode)),
            y: Math.max(1, _resolveSeamLenMm('y', detailNode)),
            z: thick,
            thick,
            o,
          };
        }

        /**
         * Fallback ��� iframe: furnitureAnchor + offset �������� ��������� �������
         * (��� �� ����, ��� setup3HolePlacementViaFurnitureWorld).
         */
