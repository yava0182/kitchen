      async function placeDrillPreviewHardwareAt(prepared, posMm, originX, originY, originZ, U, name, rotDeg) {
        const Eng = window.ClodisDrillEngine;
        let px;
        let py;
        let pz;
        if (Eng?.placeTemplateHardware) {
          const hw = Eng.placeTemplateHardware({
            O: { x: originX, y: originY, z: originZ },
            eX: { x: 1, y: 0, z: 0 },
            eY: { x: 0, y: 1, z: 0 },
            eZ: { x: 0, y: 0, z: 1 },
            mmPerWorldUnit: 1 / U,
            offsetMm: posMm,
          });
          px = hw.position.x;
          py = hw.position.y;
          pz = hw.position.z;
        } else {
          px = originX + (Number(posMm.x) || 0) * U;
          py = originY - (Number(posMm.y) || 0) * U;
          pz = originZ - (Number(posMm.z) || 0) * U;
        }
        const modelRoot = bakeModelRootToGlobalTHREE(prepared);
        if (!modelRoot.children.length) return null;
        modelRoot.scale.multiplyScalar(U);
        modelRoot.position.set(px, py, pz);
        const rx = (Number(rotDeg?.x) || 0) * (Math.PI / 180);
        const ry = (Number(rotDeg?.y) || 0) * (Math.PI / 180);
        const rz = (Number(rotDeg?.z) || 0) * (Math.PI / 180);
        // �� ������: Y ������ ����� = −Y �� �������; ������� � ��-�� ������� → ������������ ���� Y.
        modelRoot.rotation.set(rx, -ry, -rz, 'XYZ');
        modelRoot.name = name || '__drill_preview_hardware';
        try {
          modelRoot.updateMatrixWorld(true);
          const bb = new THREE.Box3().setFromObject(modelRoot);
          if (!bb.isEmpty()) {
            const sz = bb.getSize(new THREE.Vector3());
            const maxDim = Math.max(sz.x, sz.y, sz.z);
            if (Number.isFinite(maxDim) && maxDim > 1e-8 && maxDim < 0.8) {
              modelRoot.scale.multiplyScalar(1000);
              modelRoot.updateMatrixWorld(true);
            }
          }
        } catch (_) {}
        scene.add(modelRoot);
        modelObjs.push(modelRoot);
        addAnchorMarker(px, py, pz);
        applyDrillPreviewHardwareDisplayMode();
        return { modelRoot, px, py, pz };
      }

      /** ������� (����) vs ������� � ������� �3D ������ ���������. */
      function applyDrillPreviewHardwareDisplayMode() {
        const contour = !!document.getElementById('drill-preview-show-wire')?.checked;
        modelObjs.forEach((root) => {
          if (!root || root.isMesh && root.geometry?.type === 'SphereGeometry') return;
          root.traverse((o) => {
            if (!o?.isMesh) return;
            if (o.userData?.isDrillPreviewAnchor) return;
            if (o.userData?.isDrillPreviewContour) return;
            if (!o.material) return;
            const mats = Array.isArray(o.material) ? o.material : [o.material];
            mats.forEach((m) => {
              if (!m) return;
              if (m.userData?.__previewColorHex == null && m.color?.getHex) {
                m.userData.__previewColorHex = m.color.getHex();
              }
            });
            if (contour) {
              if (!o.userData.__contourLines && o.geometry) {
                try {
                  const edges = new THREE.EdgesGeometry(o.geometry, 28);
                  const lines = new THREE.LineSegments(
                    edges,
                    new THREE.LineBasicMaterial({
                      color: 0x1e293b,
                      depthTest: true,
                      transparent: true,
                      opacity: 0.92,
                    })
                  );
                  lines.userData.isDrillPreviewContour = true;
                  o.add(lines);
                  o.userData.__contourLines = lines;
                } catch (_) {}
              }
              if (o.userData.__contourLines) o.userData.__contourLines.visible = true;
              mats.forEach((m) => {
                if (!m) return;
                m.transparent = true;
                m.opacity = 0.06;
                m.depthWrite = false;
                if (m.color) m.color.setHex(0x94a3b8);
              });
            } else {
              if (o.userData.__contourLines) o.userData.__contourLines.visible = false;
              mats.forEach((m) => {
                if (!m) return;
                m.transparent = false;
                m.opacity = 1;
                m.depthWrite = true;
                if (m.color && m.userData?.__previewColorHex != null) {
                  m.color.setHex(m.userData.__previewColorHex);
                }
              });
            }
          });
        });
      }

      async function loadPreviewHardwareModel(drill, setupType, originX, originY, originZ, U) {
        const show3d = document.getElementById('drill-preview-show-3d')?.checked !== false;
        const st = Number(setupType) || Number(drill?.setupType) || 1;
        const corpusId =
          resolveDrillCorpusModelId(drill) ||
          Number(document.getElementById('drill-cabinet-model-id')?.value) ||
          0;
        const facadeId =
          Number(drill?.facadeModelId) ||
          Number(document.getElementById('drill-facade-model-id')?.value) ||
          0;
        setPreviewModelStatus('');
        if (!show3d) return;
        if (!corpusId && !(st === 2 && facadeId)) {
          setPreviewModelStatus('3D: �������� ������ � �3D-������ �������', true);
          return;
        }

        const gen = ++modelLoadGen;
        setPreviewModelStatus('3D: ���������');
        await ensureAdminGltfLoader();
        if (!window.GLTFLoader) {
          setPreviewModelStatus('3D: GLTFLoader �� �������� (importmap / ����)', true);
          return;
        }

        const statusBits = [];
        if (corpusId > 0) {
          const url = await resolveDrillPreviewModelUrl(corpusId);
          if (!url || gen !== modelLoadGen || !scene) {
            setPreviewModelStatus('3D: URL ������� �� ������ (��������� ������, Ctrl+F5)', true);
            return;
          }
          const probeErr = await probeDrillPreviewModelUrl(url);
          if (probeErr) {
            setPreviewModelStatus(`3D: ������ ���������� ${url} (${probeErr})`, true);
            return;
          }
          const prepared = await prepareDrillPreviewPreparedRoot(corpusId, url);
          if (!prepared || gen !== modelLoadGen || !scene) {
            setPreviewModelStatus(`3D: GLB ������� �� ���������� (${url})`, true);
            return;
          }
          const vis = drillPreviewVisualOffsetMm(drill);
          const rot = drillPreviewVisualRotDeg(drill);
          const placed = await placeDrillPreviewHardwareAt(
            prepared,
            vis,
            originX,
            originY,
            originZ,
            U,
            '__drill_preview_hardware_corpus',
            rot
          );
          if (!placed) {
            setPreviewModelStatus(`3D: GLB ������� ������ (${url})`, true);
            return;
          }
          statusBits.push(
            `#${corpusId} ������ pos ${Number(vis.x).toFixed(1)},${Number(vis.y).toFixed(1)},${Number(vis.z).toFixed(1)} rot ${Math.round(Number(rot.x) || 0)},${Math.round(Number(rot.y) || 0)},${Math.round(Number(rot.z) || 0)}`
          );
        }

        if (st === 2 && facadeId > 0) {
          const urlF = await resolveDrillPreviewModelUrl(facadeId);
          if (urlF && gen === modelLoadGen && scene) {
            const probeF = await probeDrillPreviewModelUrl(urlF);
            if (!probeF) {
              const preparedF = await prepareDrillPreviewPreparedRoot(facadeId, urlF);
              if (preparedF && gen === modelLoadGen && scene) {
                const visF = drillPreviewFacadeVisualOffsetMm(drill);
                const rotF = drillPreviewFacadeVisualRotDeg(drill);
                const placedF = await placeDrillPreviewHardwareAt(
                  preparedF,
                  visF,
                  originX,
                  originY,
                  originZ,
                  U,
                  '__drill_preview_hardware_facade',
                  rotF
                );
                if (placedF) {
                  statusBits.push(
                    `#${facadeId} ����� pos ${Number(visF.x).toFixed(1)},${Number(visF.y).toFixed(1)},${Number(visF.z).toFixed(1)} rot ${Math.round(Number(rotF.x) || 0)},${Math.round(Number(rotF.y) || 0)},${Math.round(Number(rotF.z) || 0)}`
                  );
                }
              }
            }
          }
        }

        setPreviewModelStatus(statusBits.length ? `3D: ${statusBits.join(' � ')}` : '3D: ��� �������');
      }

      function freeOtherAdminWebgl() {
        try {
          if (typeof fbDestroy3D === 'function') fbDestroy3D();
        } catch (_) {}
        try {
          if (typeof window.__cldDisposeMaterial3dPreview === 'function') {
            window.__cldDisposeMaterial3dPreview();
          }
        } catch (_) {}
        try {
          if (typeof window.__cldDisposeEdge3dPreview === 'function') {
