    function drawBM_nails(svg, row) {
      const tw = 18;
      const vh = 72;
      const hh = 14;
      const hw = 98;
      const gap = 52;
      const d1h = 6;
      const d2h = 5;
      const nailW = 2.5;
      const vy = 56;
      const seamY = vy + vh;
      const nailY = seamY - 5;
      const holeEndX = (vx, jointX) => jointX + 56;
      const yDimTop = vy - 22;

      function nailBlock(ox, mode) {
        const vx = ox;
        const jointX = vx + tw;
        const endX = holeEndX(vx, jointX);
        let t = '';
        t += bmPanel(vx, vy, tw, vh);
        t += bmPanel(vx, seamY, hw, hh);
        t += bmHoleCut(jointX - 6, nailY - d1h, 6, d1h * 2);
        t += bmHoleCut(jointX - 1.5, seamY + 2, endX - jointX + 3, hh - 4);
        t += bmBolt(vx + 1.5, nailY - nailW / 2, endX - vx - 1.5, nailW);
        t += bmSeamLine(jointX, vy, jointX, seamY + hh);
        t += bmCenterLine(vx + 2, nailY, endX + 6, nailY);
        t += bmDimV(nailY - d1h, nailY + d1h, vx - 18, 'D1', true);
        t += bmDimV(nailY - d2h, nailY + d2h, vx + hw + 20, 'D2', false);
