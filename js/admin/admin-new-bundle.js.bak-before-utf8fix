      const h1zone = 22; // width of shaft area = H1 label span
      const h1w = d1zone + h1zone; // total torec hole depth
      const d1h = 8;  // hole half-height = D1/2 visually
      const eccR = 12, eccX = seamX + 20; // eccentric
      let s = bmSvgDefs();
      s += bmPanel(vx, vpY, lfW, et);       // LEFT: thin shelf (����� view)
      s += bmPanel(seamX, vy, pw, ph);       // RIGHT: tall side (face view)
      // Torec hole in LEFT panel right edge
      s += bmHoleCut(seamX - h1w, edgeCy - d1h, h1w, d1h * 2);
