        const types = Array.isArray(typesData) ? typesData : (typesData.items || []);
        if (!types.length) {
          container.innerHTML = '<div class="text-muted p-3">��� ����� ��������. �������� ���� � ������� �������� ��������� → ���� ���������.</div>';
          return;
        }
        let html = '';
        for (const t of types) {
