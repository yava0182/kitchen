          const idSet = new Set(ctx.allowedEdgeIds.map((id) => Number(id)).filter((n) => Number.isFinite(n) && n > 0));
          if (idSet.size > 0) {
            out = out.filter((it) => idSet.has(Number(it?.id)));
          }
