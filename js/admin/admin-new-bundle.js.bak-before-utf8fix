              const modId = nd.id || nodeEl.getAttribute('data-node-id') || '';
              return {
                type: 'module',
                ...(modId ? { id: String(modId) } : {}),
                name,
                active,
                size: {
                  x: toNumOrExpr(nd.size?.x, 's:x'),
                  y: toNumOrExpr(nd.size?.y, 's:y'),
                  z: sizeZValue,
                },
                pos: {
                  x: toNumOrExpr(nd.position?.x, 0),
                  y: toNumOrExpr(nd.position?.y, 0),
                  z: toNumOrExpr(nd.position?.z, 0),
                },
                pivot: nd.anchor || { x: -1, y: -1, z: -1 },
                rot: {
                  x: toNumOrExpr(nd.rotation?.x, 0),
                  y: toNumOrExpr(nd.rotation?.y, 0),
                  z: toNumOrExpr(nd.rotation?.z, 0),
                },
                spec: moduleSpec,
                ...(Array.isArray(nd.accessories) && nd.accessories.length > 0 ? { accessories: nd.accessories } : {}),
                children: [],
              };
            }
            const size = nd.size || {};
            const pos = nd.position || {};
            const pathStr = path != null ? String(path) : '';
            const isSubSection = pathStr.indexOf(',') !== -1;
            if (isSubSection) {
              ['x', 'y', 'z'].forEach((axis) => {
                const v = size[axis];
                if (v === undefined || v === null || String(v).trim() === '') {
