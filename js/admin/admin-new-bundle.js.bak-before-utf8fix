        }

        /** ��������� ����� � ��������� ������ (���� → �����), �� �� ������ ��������. */
        async function _skipJointGroupToNext() {
          const node = _jointNode;
          if (!node) return;
          const q = await _querySeamContactsFromIframe(node);
          _jointSeamContactsCache = q.contacts || [];
          _jointSeamGroupsCache = _normalizeSeamGroups(_jointSeamContactsCache, q.groups);
          if (!_jointSeamContactsCache.length) {
            alert('��� ��������� �����↔������ � ������� ≈ 0 �� �� ���� ������.');
            return;
          }
          if (!_jointSeamGroupsCache.length) {
            _postHighlightSeamGroup(node, null);
            _renderCurrentGroup();
            return;
          }
          _jointGroupIdx = (_jointGroupIdx + 1) % _jointSeamGroupsCache.length;
          const g = _jointSeamGroupsCache[_jointGroupIdx];
          _renderCurrentGroup();
          _postHighlightSeamGroup(node, g);
          // ������ ������� �� ����� ���������� ������ (���� ����� ��� �������).
          const selEl = document.getElementById('constructor-joint-scheme-select');
          if (Number(selEl?.value) > 0) {
            _setTransparentOutlineMode(true);
            _previewGroupInIframe();
          }
        }

        /** ���� SVG-������ ����� */
        function _updateJointPreview(seamLen, schemeId) {
          const container = document.getElementById('constructor-joint-preview');
          const svg       = document.getElementById('constructor-joint-preview-svg');
          const info      = document.getElementById('constructor-joint-preview-info');
          if (!container || !svg) return;

          if (!schemeId) { container.style.display = 'none'; return; }
          const scheme = readSchemes().find(s => Number(s.id) === Number(schemeId));
          if (!scheme) { container.style.display = 'none'; return; }

          container.style.display = 'block';
          const result = calcSchemePositions(scheme, seamLen);
          const W = 460, PAD = 20;
          const scale = W / Math.max(seamLen, 1);

          let svgContent = `<rect x="${PAD}" y="15" width="${W}" height="20" fill="#dce8f0" stroke="#7aadcc" stroke-width="1" rx="2"/>`;
          result.positions.forEach(pos => {
            const x = PAD + pos * scale;
            svgContent += `<circle cx="${x}" cy="25" r="4" fill="#e85454" stroke="#c03030" stroke-width="1"/>`;
            svgContent += `<text x="${x}" y="12" text-anchor="middle" font-size="8" fill="#555">${Math.round(pos)}</text>`;
          });
          svgContent += `<line x1="${PAD}" y1="45" x2="${PAD+W}" y2="45" stroke="#aaa" stroke-width="0.8"/>`;
          svgContent += `<text x="${PAD+W/2}" y="57" text-anchor="middle" font-size="9" fill="#888">${seamLen} ��</text>`;
          svg.innerHTML = svgContent;
          svg.setAttribute('viewBox', `0 0 ${W + PAD*2} 60`);
          if (info) info.textContent = `${result.count} ��. � �����: ${result.mode}`;
        }

        /** ������ ����������� ���� (� pre-mode ��� �������) */
        function _renderJointAssignedList(schemes) {
          const el = document.getElementById('constructor-joint-assigned-list');
          if (!el) return;
          if (!schemes?.length) { el.innerHTML = ''; return; }
          const allSchemes = readSchemes();
          el.innerHTML = schemes.map(j => {
            const s = allSchemes.find(x => x.id === j.schemeId);
            return `<div><span style="color:#7c3aed;">●</span> <b>${esc(_jointEntryLabel(j))}</b>: ${s ? esc(s.name) : '#' + j.schemeId}</div>`;
          }).join('');
        }

        // ── ����������� ������ (������������� ���� ���) ──────────────────────

        function _initJointHandlers() {
          const startBtn  = document.getElementById('constructor-joint-start-btn');
          const applyBtn  = document.getElementById('constructor-joint-apply-btn');
          const finishBtn = document.getElementById('constructor-joint-finish-btn');
          const cancelBtn = document.getElementById('constructor-joint-cancel-btn');
          const nextGrpBtn = document.getElementById('constructor-joint-next-group-btn');
          const selEl     = document.getElementById('constructor-joint-scheme-select');
          const facingInBtn = document.getElementById('constructor-joint-facing-inside');
          const facingOutBtn = document.getElementById('constructor-joint-facing-outside');

          // ── ����� ������ ����������� ─────────────────────────────────────────
          if (startBtn && !startBtn.__jointBound) {
            startBtn.__jointBound = true;
            startBtn.addEventListener('click', () => _startJointMode());
          }

          if (nextGrpBtn && !nextGrpBtn.__jointBound) {
            nextGrpBtn.__jointBound = true;
            nextGrpBtn.addEventListener('click', () => _skipJointGroupToNext());
          }

          if (facingInBtn && !facingInBtn.__jointBound) {
            facingInBtn.__jointBound = true;
            facingInBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              _jointFacing = 'inside';
              _syncJointFacingButtons();
              if (Number(selEl?.value) > 0) {
                _setTransparentOutlineMode(true);
                _previewGroupInIframe();
              }
            });
          }
          if (facingOutBtn && !facingOutBtn.__jointBound) {
            facingOutBtn.__jointBound = true;
            facingOutBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              _jointFacing = 'outside';
              _syncJointFacingButtons();
              if (Number(selEl?.value) > 0) {
                _setTransparentOutlineMode(true);
                _previewGroupInIframe();
              }
            });
          }

          // ── ����������: ��������� ����� � ��������� �������� ������ ─────────
          if (applyBtn && !applyBtn.__jointBound) {
            applyBtn.__jointBound = true;
            applyBtn.addEventListener('click', async () => {
              const node = _jointNode;
              if (!node) return;
              if (node.getAttribute('data-node-type') !== 'detail') {
                alert('����� ������ ������� ������ ��� ������ � ������ (�� ��� ������). �������� ������ ���� ����� � ���������.');
                return;
              }
              const schemeId = Number(selEl?.value) || 0;
              if (!schemeId) { alert('�������� ����� �������'); return; }

              if (!node.nodeData) node.nodeData = {};
              if (!Array.isArray(node.nodeData.jointSchemes)) node.nodeData.jointSchemes = [];

              const scheme = readSchemes().find(s => Number(s.id) === Number(schemeId));
              const tpl = readDrills().find(t => Number(t.id) === Number(scheme?.templateId));
              const setupType = _resolveDrillSetupTypeFromTemplate(tpl);
              const q = await _querySeamContactsFromIframe(node);
              _jointSeamContactsCache = q.contacts || [];
              _jointSeamGroupsCache = _normalizeSeamGroups(_jointSeamContactsCache, q.groups);
              if (!(_jointSeamGroupsCache || []).length) {
                alert('��� ������ �����↔������ �� ���� ������. ��������� �������� ������ � ������.');
                return;
              }
              const g = _jointSeamGroupsCache[_jointGroupIdx] || _jointSeamGroupsCache[0];
              const idSet = new Set((g?.contactIds || []).map(String));
              const axis = String(g?.axis || g?.key || '');
              const matched = (_jointSeamContactsCache || []).filter((c) =>
                idSet.size
                  ? idSet.has(String(c.id))
                  : String(c.conditionKey || c.groupKey || c.seamAxis || '') === axis ||
                    String(c.seamAxis || c.groupAxis || '') === axis);
              if (!matched.length) {
                alert('� �������� ������ ��� ���������. ������� ���������� ����� ��� ������������� �����.');
                return;
              }
              // ��� ������� �� ���. ������ ����� � ������ �� ��� �������� ������.
              const matchedOk = matched;
              const cmId = Number(scheme?.cabinetModelId) || Number(tpl?.cabinetModelId) || 0;
              const facingNorm = _normalizeJointFacing(_jointFacing);

              const usedIdx = new Set();
              const newEntries = matchedOk.map((c) => {
                const jointIdx = _stableJointIdxForContact(c, usedIdx);
                const hj = Number(c.hostJointIdx);
                const sizeKey =
                  Number.isFinite(hj) && hj >= 0 && hj <= 3
                    ? _jointSeamSizeKey(hj, node)
                    : '';
                const seamLen =
                  Number(c.seamLenMm) > 0
                    ? Number(c.seamLenMm)
                    : (Number(c.seamOverlapMm) > 0
                      ? Number(c.seamOverlapMm)
                      : (sizeKey ? _resolveSeamLenMm(sizeKey, node) : 0));
                const entry = {
                  jointIdx,
                  contactId: String(c.id),
                  neighborName: c.neighborName || '',
                  conditionKey: c.conditionKey || g?.key || '',
                  hostFaceType: c.hostFaceType || '',
                  schemeId,
                  schemeName: scheme?.name || '',
                  templateId: Number(scheme?.templateId) || Number(tpl?.id) || 0,
                  setupType,
                  seamLen,
                  seamSizeKey: sizeKey,
                  facing: facingNorm,
                };
                if (cmId > 0) entry.cabinetModelId = cmId;
                return entry;
              });

              const replaceIds = new Set(newEntries.map((e) => String(e.contactId)));
              const replaceIdx = new Set(newEntries.map((e) => Number(e.jointIdx)));
              // ������� ������ ������ ��� �� ��������� / �������� ������
              node.nodeData.jointSchemes = node.nodeData.jointSchemes.filter((j) => {
                if (j.contactId != null && replaceIds.has(String(j.contactId))) return false;
                if (replaceIdx.has(Number(j.jointIdx))) return false;
                return true;
              });
              newEntries.forEach((entry) => node.nodeData.jointSchemes.push(entry));

              console.log('[CLD-SAVE-JOINT] ������������ ���������:', {
                nodeId: node.getAttribute('data-node-id'),
                nodeName: node.nodeData?.name,
                dataNodeType: node.getAttribute('data-node-type'),
                jointSchemes: node.nodeData.jointSchemes,
                cabinetModelId: cmId || null,
                contacts: newEntries.map((e) => e.contactId),
              });

              // ������� �������� (jointSchemes → ���������), ����� type:model.
              if (typeof saveConstructorNodeData === 'function') saveConstructorNodeData(node);
              _postJointSchemes(node);
              syncJointFittingTreeChildren(node);
              if (typeof window.__ppPostModuleToIframe === 'function') {
                try { window.__ppPostModuleToIframe(); } catch (_) {}
              }

              try {
                const spawned = await _spawnJointSchemeModels(
                  node,
                  [...replaceIdx],
                  scheme || { id: schemeId, cabinetModelId: cmId, name: scheme?.name, templateId: Number(scheme?.templateId) || 0 },
                  facingNorm,
                );
                if (!(Number(spawned) > 0) && cmId > 0) {
                  alert(
                    '����� ��������, �� 3D-������ �� ���� �� ������ (��� ������ �������� � ������).\n' +
                    'Ctrl+F5 → ����� ����� → ����������. ���� ����� ����� � F12 → ��� [CLD-JOINT] spawn skip.',
                  );
                } else if (!(cmId > 0)) {
                  console.log('[CLD-JOINT] ����� ��� cabinetModelId � ������ ��������� (��� 3D ������)');
                }
              } catch (e) {
                console.error('[CLD-JOINT] spawn models', e);
                alert('������ ��������� 3D �������: ' + (e?.message || e));
              }

              if (typeof saveConstructorNodeData === 'function') saveConstructorNodeData(node);
              if (typeof window.__ppPostModuleToIframe === 'function') {
                try { window.__ppPostModuleToIframe(); } catch (_) {}
              }
              // ����� ��������� � ������� ���: 3D ����� ������, ��� �������������� ������������.
              // ���������� ����� ������������ �������� ��� ��� �������������.
              _setTransparentOutlineMode(false);

              // ��������� ������ �������� ������
              if (_jointSeamGroupsCache.length) {
                _jointGroupIdx = (_jointGroupIdx + 1) % _jointSeamGroupsCache.length;
                _postHighlightSeamGroup(node, _jointSeamGroupsCache[_jointGroupIdx]);
                const nextIds = new Set(
                  (_jointSeamGroupsCache[_jointGroupIdx]?.contactIds || []).map(String),
                );
                const next = (node.nodeData.jointSchemes || []).find((j) =>
                  j.contactId != null && nextIds.has(String(j.contactId)));
                if (selEl) selEl.value = next ? String(next.schemeId) : '';
                _renderCurrentGroup();
              }
            });
          }

          // ── ���������: ��������� � ����� �� ������ ──────────────────────────
          if (finishBtn && !finishBtn.__jointBound) {
            finishBtn.__jointBound = true;
            finishBtn.addEventListener('click', () => {
              if (_jointNode && typeof saveConstructorNodeData === 'function') {
                saveConstructorNodeData(_jointNode);
              }
              _exitJointMode(true);
            });
          }

          // ── ��������: ����� ��� ��������� ───────────────────────────────────
          if (cancelBtn && !cancelBtn.__jointBound) {
            cancelBtn.__jointBound = true;
            cancelBtn.addEventListener('click', () => _exitJointMode(false));
          }

          // ── SELECT: �������� ������ + �������� ���������� ����� + 3D preview ──
          if (selEl && !selEl.__jointBound) {
            selEl.__jointBound = true;
            selEl.addEventListener('change', (e) => {
              e.stopPropagation();
              if (!_jointNode) return;
              const g0 = _jointSeamGroupsCache[_jointGroupIdx] || _jointSeamGroupsCache[0];
              const ids0 = new Set((g0?.contactIds || []).map(String));
              const axis0 = String(g0?.axis || g0?.key || '');
              const seamLen = (_jointSeamContactsCache || [])
                .filter((c) =>
                  ids0.size
                    ? ids0.has(String(c.id))
                    : String(c.seamAxis || c.groupAxis || '') === axis0)
                .reduce((m, c) => Math.max(m, Number(c.seamLenMm) || 0), 0)
                || (() => {
                  const slot0 = (g0?.slots || [0])[0];
                  return _resolveSeamLenMm(_jointSeamSizeKey(slot0, _jointNode), _jointNode);
                })();
              const sid = Number(selEl.value) || 0;
              _updateJointPreview(seamLen, sid);
              _syncJointFacingButtons();
              if (selEl.value) {
                _setTransparentOutlineMode(true);
                _previewGroupInIframe();
              }
            });
          }

        }

        /**
         * ��������� ������ ������� ������� ������ � iframe (�� ������� ����������).
         * �������� ��� ����������� ����� ������ �����, ����� ��� �� ��������.
         */
        function _previewGroupInIframe() {
          const node = _jointNode;
          if (!node || typeof __ppPreviewIframe === 'undefined' || !__ppPreviewIframe?.contentWindow) return;
          const selEl = document.getElementById('constructor-joint-scheme-select');
          const schemeId = Number(selEl?.value) || 0;
          if (!schemeId) return;
          const scheme = readSchemes().find(s => Number(s.id) === Number(schemeId));
          if (!scheme) return;

          const g = _jointSeamGroupsCache[_jointGroupIdx] || _jointSeamGroupsCache[0];
          const idSet = new Set((g?.contactIds || []).map(String));
          const axis = String(g?.axis || g?.key || '');
          const matched = (_jointSeamContactsCache || []).filter((c) =>
            idSet.size
              ? idSet.has(String(c.id))
              : String(c.conditionKey || c.groupKey || c.seamAxis || '') === axis ||
                String(c.seamAxis || c.groupAxis || '') === axis);
          if (!matched.length) return;

          const allSch = readSchemes();
          const usedIdx = new Set();
          const previewEntries = matched.map((c) => {
            const jointIdx = _stableJointIdxForContact(c, usedIdx);
            const hj = Number(c.hostJointIdx);
            const sizeKey =
              Number.isFinite(hj) && hj >= 0 && hj <= 3
                ? _jointSeamSizeKey(hj, node)
                : '';
            return _enrichJointEntry({
              jointIdx,
              contactId: String(c.id),
              neighborName: c.neighborName || '',
              conditionKey: c.conditionKey || g?.key || '',
              hostFaceType: c.hostFaceType || '',
              schemeId,
              schemeName: scheme.name,
              facing: _normalizeJointFacing(_jointFacing),
              seamLen: Number(c.seamLenMm) > 0
                ? Number(c.seamLenMm)
                : (Number(c.seamOverlapMm) > 0 ? Number(c.seamOverlapMm) : 0),
              seamSizeKey: sizeKey,
            }, allSch, node);
          });

          const previewIds = new Set(previewEntries.map((e) => String(e.contactId || '')));
          const previewIdx = new Set(previewEntries.map((e) => Number(e.jointIdx)));
          const otherEntries = (node.nodeData?.jointSchemes || [])
            .filter((j) => {
              if (j.contactId != null && previewIds.has(String(j.contactId))) return false;
              if (previewIdx.has(Number(j.jointIdx))) return false;
              return true;
            })
            .map(j => _enrichJointEntry(j, allSch, node));

          const nodePath = (typeof getNodePath === 'function' ? getNodePath(node) : null) ?? '';
          const iframePath = (typeof domPathToIframePath === 'function' ? domPathToIframePath(nodePath) : nodePath) || '';
          const merged = [...otherEntries, ...previewEntries];
          const prevHoles = merged.reduce((n, e) => n + (e.positions?.length || 0), 0);
          console.log('[CLD-JOINT][admin] → iframe preview', { domPath: nodePath, nodePath: iframePath || '(fallback)', previewEntries, otherEntries: otherEntries.length, totalHolePoints: prevHoles });
          __ppPreviewIframe.contentWindow.postMessage({
            type: 'cld:setJointSchemes',
            nodePath: iframePath,
            jointSchemes: merged
          }, '*');
        }

        /**
         * ����� �� ������ ����������� �������.
         * save=true: ��������� � pre-mode (�������� ������ + ������ ����������)
         * save=false: ������ ������ active-mode ��� ����������
         */
        function _exitJointMode(save) {
          const preMode    = document.getElementById('constructor-joint-pre-mode');
          const activeMode = document.getElementById('constructor-joint-active-mode');
          if (activeMode) activeMode.style.display = 'none';
          if (preMode)    preMode.style.display    = '';

          _postClearJointHighlight();
          _setTransparentOutlineMode(false);

          if (save && _jointNode) {
            _renderJointAssignedList(_jointNode.nodeData?.jointSchemes || []);
            syncJointFittingTreeChildren(_jointNode);
          }
        }

        function _isFacadeDoorAnimatorWithSiblingHinge(treeNode) {
          try {
            if (!treeNode || String(treeNode.nodeData?.originalType || '').toLowerCase() !== 'animator') {
              return false;
            }
            const ch = treeNode.querySelector(':scope > .tree-node-children');
            const hasFacadeChild =
              !!ch &&
              Array.from(ch.children)
                .filter((el) => el.classList?.contains('constructor-tree-node'))
                .some(
                  (el) =>
                    String(el.getAttribute('data-original-type') || el.nodeData?.originalType || '').toLowerCase() ===
                    'facade'
                );
            const wrap = treeNode.parentElement;
            const hasHingeModuleSibling =
              !!wrap &&
              Array.from(wrap.children)
                .filter((el) => el.classList?.contains('constructor-tree-node') && el !== treeNode)
                .some((el) => {
                  const ot = String(el.getAttribute('data-original-type') || el.nodeData?.originalType || '').toLowerCase();
                  return ot === 'module' && String(el.nodeData?.spec?.element_type || '').toLowerCase() === 'hinges';
                });
            return hasFacadeChild && hasHingeModuleSibling;
          } catch (_) {
            return false;
          }
        }

        // ============================================================
        // ���������� ��������� � ��������� �������
        function saveConstructorNodeData(node) {
          if (!node) return;
          
          const typeInput = document.getElementById('catalog-constructor-property-type');
          const nameInput = document.getElementById('catalog-constructor-property-name');
          const idInput = document.getElementById('catalog-constructor-property-id');
          
          if (!node.nodeData) {
            node.nodeData = {};
          }
          
          // ��������� ������� ����: � ���� "���" ������������ ���������, ��� ���������� � ���� (model, facade � �.�.)
          // �����: ��� ����������� �������� ("�������� (id: ...)", "������� (...)") ����� ����� ������� ��������.
          const typeInputVal = String(typeInput?.value || '').trim();
          let typeKeyRaw =
            TYPE_NAMES_REVERSE[typeInputVal] ||
            typeInputVal ||
            node.nodeData.originalType ||
            'section';
          if (!TYPE_NAMES_REVERSE[typeInputVal]) {
            if (/^��������\b/i.test(typeInputVal)) typeKeyRaw = 'furniture';
            else if (/^�������\b/i.test(typeInputVal)) typeKeyRaw = 'module';
            else if (/^������\b/i.test(typeInputVal)) typeKeyRaw = 'model';
            else if (/^��������\b/i.test(typeInputVal)) typeKeyRaw = 'animator';
            else if (/^�����\b/i.test(typeInputVal)) typeKeyRaw = 'facade';
            else if (/^������\b/i.test(typeInputVal)) typeKeyRaw = 'section';
          }
          let typeKey = String(typeKeyRaw).toLowerCase().trim();
          // ���-��������: ���� � spec.group=furniture ������ ������ ���������� furniture,
          // ����� �������� ����� ������ � facade ����� ���������� �� UI.
          if (String(node.nodeData?.spec?.group || '').toLowerCase() === 'furniture') {
            typeKey = 'furniture';
          }
          node.nodeData.originalType = typeKey;
          const isUiDetail =
            typeKey === 'detail' ||
            typeKey === 'wall' ||
            typeKey === 'facade' ||
            typeKey === 'module' ||
            typeKey === 'model' ||
            typeKey === 'furniture' ||
            typeKey === 'animator';
          node.nodeData.type = isUiDetail ? 'detail' : typeKey;
          if (typeKey === 'facade' || typeKey === 'module' || typeKey === 'model' || typeKey === 'furniture' || typeKey === 'animator') {
            node.setAttribute('data-original-type', typeKey);
          } else if (node.hasAttribute('data-original-type')) {
            node.removeAttribute('data-original-type');
          }
          if (node === rootModule) {
            const catalogLabel =
              typeof window.__cldGetCatalogModuleDisplayName === 'function'
                ? window.__cldGetCatalogModuleDisplayName()
                : String(document.getElementById('catalog-item-edit-name')?.value || '').trim();
            node.nodeData.name = catalogLabel || node.nodeData.name || '';
          } else {
            node.nodeData.name = nameInput?.value || '';
          }
          const _rawIdVal = String(idInput?.value ?? '').trim();
          node.nodeData.id = _rawIdVal.startsWith('node_') ? '' : _rawIdVal;
          // ��� Clodis: dropdown ��������� ����� ��������� ��� ������ spec.fn (����� + slide + ��������� module hinges).
          if (typeKey === 'animator') {
            const animFnUi = document.getElementById('catalog-constructor-property-animator-fn')?.value || '';
            let effectiveFn = String(node.nodeData?.spec?.fn || '').toLowerCase() === 'rotate' ? 'rotate' : 'slide';
            if (animFnUi === 'rotate') effectiveFn = 'rotate';
            else if (animFnUi === 'slide') effectiveFn = 'slide';
            // �������� rotate (�������� facade + �������� module hinges) � �� hinge_animator �� �������� ������.
            if (effectiveFn === 'rotate' && !_isFacadeDoorAnimatorWithSiblingHinge(node)) {
              node.nodeData.id = 'hinge_animator';
              node.setAttribute('data-node-id', 'hinge_animator');
              if (idInput) idInput.value = 'hinge_animator';
            }
          }
          node.nodeData.hide_when_filled = document.getElementById('catalog-constructor-property-hide-when-filled')?.checked || false;
          node.nodeData.active = document.getElementById('catalog-constructor-property-active')?.checked !== false;
          node.nodeData.article = document.getElementById('catalog-constructor-property-article')?.value || '';
          if ((typeKey === 'module' || node.nodeData.originalType === 'module') && node.nodeData.spec && typeof node.nodeData.spec === 'object') {
            const canChangeId = !!document.getElementById('catalog-constructor-flat-module-swappable-top')?.checked;
            const notLoadDefault = !!document.getElementById('catalog-constructor-flat-module-no-default')?.checked;
            node.nodeData.spec.can_change = node.nodeData.spec.can_change && typeof node.nodeData.spec.can_change === 'object'
              ? node.nodeData.spec.can_change
              : {};
            node.nodeData.spec.can_change.id = canChangeId ? 1 : 0;
            node.nodeData.spec.not_load_default = notLoadDefault ? 1 : 0;
          }
          
          // ���� ��� ������ - ��������� ��� ���� ������
