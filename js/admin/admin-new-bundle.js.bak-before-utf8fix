            if (hEl) sh = parseFloat(hEl.value) || sh;
            if (dEl) sd = parseFloat(dEl.value) || sd;
          }

          let expr = raw
            .replace(/@section\.width\b/g, String(sw))
            .replace(/@section\.height\b/g, String(sh))
            .replace(/@section\.depth\b/g, String(sd))
            .replace(/\bs:x\b/g, String(sw))
            .replace(/\bs:y\b/g, String(sh))
