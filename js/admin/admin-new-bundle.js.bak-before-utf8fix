          }

          // detail → wall, facade ��� module (��� ������: type: 'facade' ��� CabinetFacadeNode, type: 'module' → fill_module)
          // ��������: ������ � element_type: "dveri_shkaf" (�����) �������� ��� type: 'module' � spec.direction
          const isDoorModule = nd.originalType === 'module' && nd.spec?.element_type === 'dveri_shkaf';
          const nameForFacade = String(nd.name || name || '');
          const ot = String(nd.originalType || '').toLowerCase();
          const isCatalogLinkedModuleNode =
            (ot === 'module' || ot === 'element') &&
            !!String(nd.spec?.element_type || '').trim() &&
            !!String(nd.spec?.id ?? nd.modelId ?? '').trim();
          const isFacade =
            !isCatalogLinkedModuleNode &&
            (ot === 'facade' ||
              (!['module', 'model', 'furniture', 'animator', 'section', 'element'].includes(ot) &&
                (nd.modelId || nd.spec?.id || /�����/i.test(nameForFacade))));
          const isModule = ot === 'module' || isCatalogLinkedModuleNode;
          
          // ������ �� ��������� (�����, �����, ���): ���������� ��� type: 'module' � ������ (fill_module)
          if (isModule) {
            const fillSectionKey = String(nd.section_key || '').trim();
            // ��������: ��� ������� �� JSON, ���� size.z �� �����, ���������� ���������� �������� (16��)
            // ������ ��������� '@section.depth', �.�. ������ ������ ����� ������������� �������.
            // ��� �������� �������� (facades* / catalog_28) � v:facade_thickness_mm (��. ������ ����).
            
            // ��������: ��� ������� ������ (isDoorModule) ��������� spec.direction ���� ��� ���
            // � JSON � ������� ������ ����� �� ���� spec.direction, �� ��� ����������� ���������������� ����� '-z'
            const moduleSpec = { ...(nd.spec || {}) };
            if (isDoorModule && !moduleSpec.direction) {
              moduleSpec.direction = '-z'; // �������� ����� (�����)
            }
            const isCatalogLinkedModule = !!String(moduleSpec.element_type || '').trim() && !!String(moduleSpec.id || '').trim();
            const isHingeLinkedModule = String(moduleSpec.element_type || '').toLowerCase() === 'hinges'
              || /^catalog_\d+$/.test(String(moduleSpec.element_type || '').toLowerCase());

            if (isHingeLinkedModule) {
              // ��� ������� hinge � iframe ������ ������ spec.ref_size_mm.
              // ���� ������������ ����� �������� size � ���� �����, �������������� ��� � spec.
              const sx = Number(nd.size?.x);
              const sy = Number(nd.size?.y);
              const sz = Number(nd.size?.z);
              if (Number.isFinite(sx) && sx > 0 && Number.isFinite(sy) && sy > 0 && Number.isFinite(sz) && sz > 0) {
                moduleSpec.ref_size_mm = { x: sx, y: sy, z: sz };
              }
            }
            if (isCatalogLinkedModule) {
              // ��� � ���� (remove_nested_modules): ��� linked module �� ������ snapshot ������,
              // ����� ��� ������ ������ ������������� ���������� ��������� �� ��������.
              delete moduleSpec.template_tree;
              delete moduleSpec.templates;
            }

            const lrRawModule = nd.sectionLayoutRole ?? nd.layout_role;
            let layout_role_module =
              typeof window.__cldNormalizeSectionLayoutRole === 'function'
                ? window.__cldNormalizeSectionLayoutRole(lrRawModule)
                : String(lrRawModule || '').trim();
            try {
              const chWrap = nodeEl.parentElement;
              const sibRoles =
                typeof window.__cldCollectSiblingFacadeShellRoles === 'function'
                  ? window.__cldCollectSiblingFacadeShellRoles(chWrap, nodeEl)
                  : new Set();
              layout_role_module =
                typeof window.__cldInferFacadeShellRoleForExport === 'function'
                  ? window.__cldInferFacadeShellRoleForExport(
                      layout_role_module,
                      moduleSpec?.element_type,
                      sibRoles
                    )
                  : layout_role_module;
            } catch (_) {}

            // ��� ������: ��� ���� ���� ����������� ������� Y, ���� � nodeData ��� ������ (s:y / 0).
            // ������/������� �������� �������� ������ �� nodeToParams → ���� ������ ����������������
            // � ����������� size.y / pos.y ��� ��������� ������ ����������� Y �� ����.
            const __rolePreset =
              typeof window.__cldLayoutRoleYPresetFields === 'function' &&
              layout_role_module &&
              layout_role_module !== 'cabinet_root'
                ? window.__cldLayoutRoleYPresetFields(layout_role_module)
                : null;
            const __sizeYRaw = nd.size?.y;
            const __posYRaw = nd.position?.y;
            const __sizeYIsDefault =
              __sizeYRaw === undefined ||
              __sizeYRaw === null ||
              __sizeYRaw === 's:y' ||
              __sizeYRaw === '0' ||
              __sizeYRaw === 0;
            const __posYIsDefault =
              __posYRaw === undefined ||
              __posYRaw === null ||
              __posYRaw === 0 ||
              __posYRaw === '0' ||
              (typeof __posYRaw === 'string' && __posYRaw.trim() === '');
            const __isFlatShelfModule =
              typeof window.__cldIsFlatCatalogShelfModule === 'function'
                ? window.__cldIsFlatCatalogShelfModule({
                    type: 'module',
                    name,
                    spec: moduleSpec,
                    layout_role: layout_role_module,
                    sectionLayoutRole: layout_role_module,
                  })
                : false;
            const __sizeYExport =
              __isFlatShelfModule
                ? 16
                : __rolePreset && __sizeYIsDefault
                  ? __rolePreset.sizeY
                  : toNumOrExpr(__sizeYRaw, 's:y');
            const __posYExport =
              __rolePreset && __posYIsDefault ? __rolePreset.posY : toNumOrExpr(__posYRaw, 0);
            const __posZRaw = nd.position?.z;
            const __posZIsDefault =
              typeof window.__cldIsExprDefaultPosZ === 'function'
                ? window.__cldIsExprDefaultPosZ(__posZRaw)
                : __posZRaw === undefined ||
                  __posZRaw === null ||
                  String(__posZRaw).trim() === '' ||
                  String(__posZRaw).replace(/\s+/g, '') === 's:z-16';
            const __facadeDepthZExpr =
              window.__CLD_FACADE_DEPTH_POS_Z_EXPR || 's:z - v:facade_thickness_mm';
            const __isFacadeShellModule =
              (typeof window.__cldIsFacadeShellLayoutRole === 'function' &&
                window.__cldIsFacadeShellLayoutRole(layout_role_module)) ||
              String(moduleSpec?.element_type || '').toLowerCase() === 'catalog_28';
            const __posZExport =
              __rolePreset && __rolePreset.posZ && __posZIsDefault
                ? __rolePreset.posZ
                : toNumOrExpr(
                    __posZRaw,
                    isDoorModule || __isFacadeShellModule ? __facadeDepthZExpr : 0
                  );
            const __sizeZRaw = nd.size?.z;
            const __sizeZIsDefault =
              typeof window.__cldIsExprDefaultSizeZ === 'function'
                ? window.__cldIsExprDefaultSizeZ(__sizeZRaw)
                : __sizeZRaw === undefined ||
                  __sizeZRaw === null ||
                  String(__sizeZRaw).trim() === '' ||
                  String(__sizeZRaw).replace(/\s+/g, '') === 's:z';
            const __facadeSizeZExpr = window.__CLD_FACADE_SIZE_Z_EXPR || 'v:facade_thickness_mm';
            const __sizeZExport =
              __isFlatShelfModule
                ? 's:z'
                : __rolePreset && __rolePreset.sizeZ && __sizeZIsDefault
                  ? __rolePreset.sizeZ
                  : toNumOrExpr(
                      __sizeZRaw,
                      isDoorModule || __isFacadeShellModule ? __facadeSizeZExpr : 16
