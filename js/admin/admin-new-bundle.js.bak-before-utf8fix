        function _resolveSeamLenMm(sizeKey, node) {
          const raw = String(node?.nodeData?.size?.[sizeKey] ?? '');
          const direct = parseFloat(raw);
          if (Number.isFinite(direct) && !/[@s:]/.test(raw)) return direct;

          const parentSection = node?.parentElement?.closest?.(
            '.constructor-tree-node[data-node-type="section"]'
