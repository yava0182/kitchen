    function buildMaterialCategoryFullName(cat, all) {
      const byId = {};
      all.forEach(c => { byId[String(c.id)] = c; });
      const chain = [];
      let cur = cat;
      while (cur) {
        if (cur.name) chain.unshift(cur.name);
        const parentId = cur.parent == null ? null : String(cur.parent);
        if (!parentId || !byId[parentId]) break;
        cur = byId[parentId];
      }
      return chain.join(' / ');
    }

