            selCoord.value = String(src.coordBase || 'auto');
            selSide.value = String(src.mountSide || 'auto');
            modal.style.display = 'block';
            const close = () => { modal.style.display = 'none'; };
            const onCancel = () => { close(); cleanup(); };
            const onOverlay = (ev) => { if (ev.target === modal) { close(); cleanup(); } };
