    }
    function bmCircleHole(cx, cy, r) {
      return `<circle cx="${cx}" cy="${cy}" r="${r}" fill="#fff" stroke="#000" stroke-width="0.6"/>`;
    }
    function bmCenterLine(x1, y1, x2, y2) {
      return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#000" stroke-width="0.3" stroke-dasharray="10,3,2,3"/>`;
    }
    function bmSeamLine(x1, y1, x2, y2) {
      return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#000" stroke-width="0.4" stroke-dasharray="6,2"/>`;
    }
    function bmDimH(x1, x2, y, label, above) {
      const ty = above ? y - 3 : y + 12;
      const ey = above ? y + 8 : y - 8;
      const span = Math.abs(x2 - x1);
      const tx = (x1 + x2) / 2;
      let s = '';
      s += `<line x1="${x1}" y1="${ey}" x2="${x1}" y2="${y}" stroke="${_DIM}" stroke-width="0.3"/>`;
      s += `<line x1="${x2}" y1="${ey}" x2="${x2}" y2="${y}" stroke="${_DIM}" stroke-width="0.3"/>`;
      if (span > 10) {
        s += `<line x1="${x1}" y1="${y}" x2="${x2}" y2="${y}" stroke="${_DIM}" stroke-width="0.5" marker-start="url(#bmArr)" marker-end="url(#bmArr)"/>`;
      } else {
        s += `<line x1="${x1 - 10}" y1="${y}" x2="${x1}" y2="${y}" stroke="${_DIM}" stroke-width="0.5" marker-end="url(#bmArr)"/>`;
        s += `<line x1="${x2}" y1="${y}" x2="${x2 + 10}" y2="${y}" stroke="${_DIM}" stroke-width="0.5" marker-start="url(#bmArr)"/>`;
      }
      s += `<text x="${tx}" y="${ty}" text-anchor="middle" font-size="${_FS}" font-family="Arial,sans-serif" fill="${_DIM}" font-style="italic">${label}</text>`;
      return s;
    }
    function bmDimV(y1, y2, x, label, left) {
      const mx = left ? x - 3 : x + 3;
      const ex = left ? x + 8 : x - 8;
      const span = Math.abs(y2 - y1);
      const ty = (y1 + y2) / 2;
      let s = '';
      s += `<line x1="${ex}" y1="${y1}" x2="${x}" y2="${y1}" stroke="${_DIM}" stroke-width="0.3"/>`;
      s += `<line x1="${ex}" y1="${y2}" x2="${x}" y2="${y2}" stroke="${_DIM}" stroke-width="0.3"/>`;
      if (span > 10) {
        s += `<line x1="${x}" y1="${y1}" x2="${x}" y2="${y2}" stroke="${_DIM}" stroke-width="0.5" marker-start="url(#bmArr)" marker-end="url(#bmArr)"/>`;
      } else {
        s += `<line x1="${x}" y1="${y1 - 10}" x2="${x}" y2="${y1}" stroke="${_DIM}" stroke-width="0.5" marker-end="url(#bmArr)"/>`;
        s += `<line x1="${x}" y1="${y2}" x2="${x}" y2="${y2 + 10}" stroke="${_DIM}" stroke-width="0.5" marker-start="url(#bmArr)"/>`;
      }
      s += `<text x="${mx}" y="${ty + 4}" text-anchor="${left?'end':'start'}" font-size="${_FS}" font-family="Arial,sans-serif" fill="${_DIM}" font-style="italic">${label}</text>`;
      return s;
    }
    function bmDimLabel(x, y, label) {
      return `<text x="${x}" y="${y}" text-anchor="middle" font-size="${_FS}" font-family="Arial,sans-serif" fill="${_DIM}" font-style="italic">${label}</text>`;
    }
    function bmDimHToPart(x1, x2, yLine, yPart, label) {
      const tx = (x1 + x2) / 2;
