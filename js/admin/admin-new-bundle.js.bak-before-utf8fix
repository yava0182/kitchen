          const seamLen = (activeContacts.length ? activeContacts : contacts)
            .reduce((m, c) => Math.max(m, Number(c.seamLenMm) || Number(c.seamOverlapMm) || 0), 0) || 500;
          _updateJointPreview(seamLen, schemeId || Number(selEl?.value) || 0);
          // ��: ����� �������� + ����� ������� → ����� ������ ������� �� �����.
          if (schemeId > 0) {
