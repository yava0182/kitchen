      /** 2D fallback: ������ ������ + ��� + ���������, ��� WebGL. */
      function update2dFallback(drill) {
        const host = document.getElementById('drill-preview-3d');
        if (!host) return;
        let canvas = host.querySelector('canvas.drill-preview-2d-fallback');
        if (!canvas) {
          host.querySelectorAll('canvas').forEach((c) => {
            try { c.remove(); } catch (_) {}
          });
          canvas = document.createElement('canvas');
          canvas.className = 'drill-preview-2d-fallback';
          canvas.style.cssText = 'display:block;width:100%;height:100%;';
          host.appendChild(canvas);
        }
        const { W, H } = hostSize(host);
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.floor(W * dpr);
        canvas.height = Math.floor(H * dpr);
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, W, H);

        const setupType = Number(
          document.querySelector('.drill-setup-type-btn.active')?.getAttribute('data-setup') ||
            drill?.setupType ||
            1
        );
        const fw = Math.max(1, Number(document.getElementById('drill-frame-w')?.value || drill?.frameW || 100));
        const fh = Math.max(1, Number(document.getElementById('drill-frame-h')?.value || drill?.frameH || 100));
        const fd =
          setupType === 1 || setupType === 4
            ? DRILL_FRAME_PART_THICKNESS_MM
            : Math.max(1, Number(document.getElementById('drill-frame-d')?.value || drill?.frameD || DRILL_FRAME_DEFAULT_DEPTH_MM));

        const pad = 36;
        const scale = Math.min((W - pad * 2) / fw, (H - pad * 2) / fh);
        const ox = W / 2;
        const oy = H / 2;
        const toX = (mmX) => ox + mmX * scale;
        const toY = (mmY) => oy - mmY * scale;

        function strokeRectMm(cx, cy, wMm, hMm) {
          ctx.strokeStyle = '#1ab394';
          ctx.lineWidth = 1.5;
          ctx.strokeRect(toX(cx - wMm / 2), toY(cy + hMm / 2), wMm * scale, hMm * scale);
        }

        const T = 16;
        if (setupType === 1) {
          strokeRectMm(0, 0, fw, fh);
        } else if (setupType === 2) {
          strokeRectMm(-fw / 2 + T / 2, 0, T, fh);
          strokeRectMm(T / 2, -(fh / 2 - T / 2), Math.max(T, fw - T), T);
        } else if (setupType === 3) {
          strokeRectMm(-fw / 2 + T / 2, 0, T, fh);
          strokeRectMm(T / 2, 0, fw - T, T);
        } else {
          strokeRectMm(-fw / 4, 0, fw / 2, fh);
          strokeRectMm(fw / 4, 0, fw / 2, fh);
        }

        let pivX = 0;
        let pivY = 0;
        if (setupType === 2) {
          pivX = -fw / 2 + T;
          pivY = -fh / 2 + T;
        } else if (setupType === 3) {
          pivX = -fw / 2;
          pivY = 0;
        }
        const axis = 18;
        ctx.lineWidth = 1.6;
        ctx.strokeStyle = '#e74c3c';
        ctx.beginPath();
        ctx.moveTo(toX(pivX), toY(pivY));
        ctx.lineTo(toX(pivX + axis), toY(pivY));
        ctx.stroke();
        ctx.strokeStyle = '#27ae60';
        ctx.beginPath();
        ctx.moveTo(toX(pivX), toY(pivY));
        ctx.lineTo(toX(pivX), toY(pivY + axis));
        ctx.stroke();
        ctx.fillStyle = '#3498db';
        ctx.beginPath();
        ctx.arc(toX(pivX), toY(pivY), 3, 0, Math.PI * 2);
        ctx.fill();

        const sk = String(setupType);
        let holes =
          drill?.holesBySetup && Array.isArray(drill.holesBySetup[sk]) ? drill.holesBySetup[sk] : [];
        if (!holes.length && Array.isArray(drill?.holes)) holes = drill.holes;
        holes.forEach((h) => {
          const diam = parseFloat(h.diameterMm ?? h.diameter) || 0;
          if (!diam) return;
          const hx = pivX + (Number(h.xMm ?? h.x) || 0);
          const hy = pivY + (Number(h.yMm ?? h.y) || 0);
          const r = Math.max(2, (diam / 2) * scale);
          ctx.strokeStyle = '#707070';
          ctx.fillStyle = 'rgba(224,224,224,0.55)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(toX(hx), toY(hy), r, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        });

        setPreviewModelStatus(
          `2D-����� (WebGL ����������). ����� ${fw}�${fh}�${fd} ��. �������� ������� � 3D � ������������� Chrome.`,
          true
        );
      }

      function hostSize(host) {
        const rect = host?.getBoundingClientRect?.();
        const W = Math.max(1, Math.floor(rect?.width || host?.clientWidth || 580));
        const H = 538;
        return { W, H };
      }

      function isPreviewAlive() {
        if (!initialized || !renderer || !scene || !camera) return false;
        const el = renderer.domElement;
        if (!el || !el.isConnected) return false;
        try {
          const gl = renderer.getContext?.();
          if (gl && typeof gl.isContextLost === 'function' && gl.isContextLost()) return false;
        } catch (_) {
          return false;
        }
        return true;
      }

      function init() {
        if (isPreviewAlive()) return;
        if (initialized) {
          try { destroy({ soft: true }); } catch (_) {}
        }
        const host = document.getElementById('drill-preview-3d');
        if (!host) return;
        if (typeof THREE === 'undefined') {
          setPreviewModelStatus('������: THREE.js �� �������� � Ctrl+F5', true);
          return;
        }
        freeOtherAdminWebgl();
        try {
          renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: 'low-power' });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
          renderer.setClearColor(0xe8eaed, 1);
          const { W, H } = hostSize(host);
          renderer.setSize(W, H);
          // �� ����� canvas ��� ��������� init (����� contextlost).
          host.querySelectorAll('canvas').forEach((c) => {
            try { c.remove(); } catch (_) {}
          });
          host.appendChild(renderer.domElement);
          renderer.domElement.addEventListener(
            'webglcontextlost',
            (ev) => {
              try { ev.preventDefault(); } catch (_) {}
              console.warn('[DrillPreview3D] WebGL context lost');
              initialized = false;
              setPreviewModelStatus('������: WebGL ������� � �������� ������� ����������� ��� Ctrl+F5', true);
            },
            false
          );
          renderer.domElement.addEventListener(
            'webglcontextrestored',
            () => {
              console.warn('[DrillPreview3D] WebGL restored � �����������');
              initialized = false;
              if (drillingEditSession?.item) update(drillingEditSession.item);
            },
            false
          );
          scene = new THREE.Scene();
          scene.background = new THREE.Color(0xe8eaed);
          camera = new THREE.PerspectiveCamera(38, W / H, 0.1, 10000);
          // ���� ��� ������� �� ������� ����: �� ���������� ambient'�� (����� ����� ��������)
          scene.add(new THREE.AmbientLight(0xffffff, 0.42));
          const dl = new THREE.DirectionalLight(0xffffff, 0.95);
          dl.position.set(2.2, 3.4, 4.2);
          scene.add(dl);
          const dl2 = new THREE.DirectionalLight(0xffffff, 0.35);
          dl2.position.set(-2.5, 1.2, -1.5);
          scene.add(dl2);
          if (typeof THREE.OrbitControls !== 'undefined') {
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.12;
          }
          initialized = true;
          animate();
        } catch (e) {
          console.error('[DrillPreview3D] init failed', e);
          initialized = false;
          renderer = null;
          scene = null;
          camera = null;
          controls = null;
          update2dFallback(drillingEditSession?.item || null);
        }
      }

      function animate() {
        if (!renderer) return;
        rafId = requestAnimationFrame(animate);
        if (!isPreviewAlive()) return;
        if (controls) controls.update();
        try {
          renderer.render(scene, camera);
        } catch (e) {
          console.warn('[DrillPreview3D] render', e);
        }
      }

      const DIR_VECTORS = {
        'x':  [1,  0,  0],
        '-x': [-1, 0,  0],
        'y':  [0,  1,  0],
        '-y': [0, -1,  0],
        'z':  [0,  0,  1],
        '-z': [0,  0, -1],
      };

      const PANEL_COLOR    = 0x1ab394;   // ������ ������ (������ �����)
      /** WebGL ����� ������ ������ ����� �������� 1px; ������� � ����� opacity ≈ ⅔ �� ����� ����. */
      const PANEL_EDGE_OPACITY = 2 / 3;
      const HOLE_COLOR     = 0xe0e0e0;   // ������-����� �������������� ���� ���������
      const HOLE_EDGE_COLOR = 0x707070;   // ������ ������ (�� ������ � �� ��������� ������)
      const ARROW_COLOR    = 0x000000;   // ����������� ���������
      const SEAM_STRIPE_COLOR = 0xc084fc; // ��� �������� ���� � ������������ (�������� ��� ���� 3)

      /** ����� �������� T (��� 3): ����� ����� T�D �� ��������� ����� x = -W/2 + T. */
      function makeType3SeamStripes(W, H, D, T) {
        const thin = 0.003;
        const jointX = -W / 2 + T;
        const mat = new THREE.MeshBasicMaterial({
          color: SEAM_STRIPE_COLOR,
          transparent: true,
          opacity: 0.88,
          depthTest: false,
          depthWrite: false,
          side: THREE.DoubleSide,
        });
        // thin � T � D � ������ ����� ����� 16 �� �� ������, �� ��� �������.
        const patch = new THREE.Mesh(new THREE.BoxGeometry(thin, T, D), mat);
        patch.position.set(jointX, 0, 0);
        patch.renderOrder = 11;
        return [patch];
      }

      // ������ � ������ ������ ���� (��� �������)
      function makePanel(W, H, D, cx, cy, cz) {
        const group = new THREE.Group();

        const geo = new THREE.BoxGeometry(W, H, D);
        const edges = new THREE.EdgesGeometry(geo);
        geo.dispose();
        const lines = new THREE.LineSegments(
          edges,
          new THREE.LineBasicMaterial({
            color: PANEL_COLOR,
            transparent: true,
            opacity: PANEL_EDGE_OPACITY,
          })
        );
        group.add(lines);

        group.position.set(cx, cy, cz);
        return group;
      }

      // ����������� ������ �� ���� ��������� (fw�fh�fd ��, T=16��)
      function buildPanels(setupType, fw, fh, fd, U) {
        const objs = [];
        const T = 16 * U;
        const W = fw * U, H = fh * U, D = fd * U;

        if (setupType === 1) {
          // ��� 1: ���� ������, ������; ������ ��������� � ������� ��������� �� ������
          objs.push(makePanel(W, H, D, 0, 0, 0));
        } else if (setupType === 2) {
          // ��� 2: L � ������ � �������� ����� W�H�D (��� PlanPlace / admin-new-bundle-r4).
          const Wdetail = Math.max(T, W - T);
          const cxVert = -W / 2 + T / 2;
          objs.push(makePanel(T, H, D, cxVert, 0, 0));
          const cxHor = T / 2;
          const cyHor = -(H / 2 - T / 2);
          objs.push(makePanel(Wdetail, T, D, cxHor, cyHor, 0));
        } else if (setupType === 3) {
          // ��� 3: T � ������ � ����� ����� �����, ����� �� ������ ������ (��� PlanPlace).
          const halfW = W / 2;
          objs.push(makePanel(T, H, D, -halfW + T / 2, 0, 0));
          objs.push(makePanel(W - T, T, D, T / 2, 0, 0));
        } else {
          // ��� 4: ��� ����������� ������ (�� Z ������� = D), ���� �� ������
          const half = W / 2;
          objs.push(makePanel(half, H, D, -W / 4, 0, 0)); // ����� �����������
          objs.push(makePanel(half, H, D,  W / 4, 0, 0)); // ������ �����������
        }
        return objs;
      }

      function makeAxisLine(len, dir, col) {
        const pts = [new THREE.Vector3(0, 0, 0), new THREE.Vector3(...dir).multiplyScalar(len)];
        const geo = new THREE.BufferGeometry().setFromPoints(pts);
        return new THREE.Line(geo, new THREE.LineBasicMaterial({ color: col }));
      }
      function makeLine(a, b, col, opacity = 1) {
        const geo = new THREE.BufferGeometry().setFromPoints([a, b]);
        return new THREE.Line(geo, new THREE.LineBasicMaterial({ color: col, transparent: opacity < 1, opacity }));
      }

      function disposeObj(o) {
        if (!o) return;
        if (o.children) o.children.forEach(disposeObj);
        if (o.geometry) o.geometry.dispose();
        if (o.material) { if (Array.isArray(o.material)) o.material.forEach(m => m.dispose()); else o.material.dispose(); }
      }
      function clearGroup(arr) {
        arr.forEach((o) => { scene.remove(o); disposeObj(o); });
        arr.length = 0;
      }

      // ������� ���������: ������-����� �������������� ����� + ������ ���� (+ ���. �������).
      function makeHoleObj(r, depth, dirVec, showArrow) {
        const group = new THREE.Group();
        const upY = new THREE.Vector3(0, 1, 0);
        const dir3 = new THREE.Vector3(...dirVec).normalize();
        const quat = new THREE.Quaternion().setFromUnitVectors(upY, dir3);

        const cylGeo = new THREE.CylinderGeometry(r, r, depth, 20);
        const cylMesh = new THREE.Mesh(cylGeo, new THREE.MeshBasicMaterial({
          color: HOLE_COLOR,
          transparent: true,
          opacity: 0.48,
          depthTest: true,
          depthWrite: false,
        }));
        cylMesh.quaternion.copy(quat);
        cylMesh.position.set(dir3.x * depth / 2, dir3.y * depth / 2, dir3.z * depth / 2);
        group.add(cylMesh);

        // thresholdAngle � ��������: �������� ������ ������� ������� ����������� (��� ������� �������).
        const cylEdges = new THREE.EdgesGeometry(cylGeo, 32);
        const cylLines = new THREE.LineSegments(
          cylEdges,
          new THREE.LineBasicMaterial({
            color: HOLE_EDGE_COLOR,
            transparent: true,
            opacity: 0.62,
            depthTest: true,
          })
        );
        cylLines.quaternion.copy(quat);
        cylLines.position.copy(cylMesh.position);
        group.add(cylLines);

        if (showArrow) {
          // ������� ��� �� 0 �� ����� ��������: ���������� ������������ ����� �� ������� depth.
          const arrowLen = depth;
          const shaftR   = Math.max(r * 0.32, depth * 0.07) / 5; // ������ ���� (��� �������)
          const coneH    = Math.max(r * 1.0, depth * 0.14);
          const shaftLen = Math.max(arrowLen - coneH, depth * 0.25);
          const arrowMat = new THREE.MeshBasicMaterial({
            color: ARROW_COLOR,
            depthTest: true,
            depthWrite: false,
            polygonOffset: true,
            polygonOffsetFactor: -1.5,
            polygonOffsetUnits: -1.5,
          });

          const shaftGeo = new THREE.CylinderGeometry(shaftR, shaftR, shaftLen, 10);
          const shaftMesh = new THREE.Mesh(shaftGeo, arrowMat);
          shaftMesh.renderOrder = 2;
          shaftMesh.quaternion.copy(quat);
          shaftMesh.position.set(
            dir3.x * (shaftLen / 2),
            dir3.y * (shaftLen / 2),
            dir3.z * (shaftLen / 2)
          );
          group.add(shaftMesh);

          const coneGeo = new THREE.ConeGeometry(Math.max(r * 0.65, shaftR * 5.0), coneH, 16);
          const coneMesh = new THREE.Mesh(coneGeo, arrowMat);
          coneMesh.renderOrder = 2;
          coneMesh.quaternion.copy(quat);
          coneMesh.position.set(
            dir3.x * (shaftLen + coneH / 2),
            dir3.y * (shaftLen + coneH / 2),
            dir3.z * (shaftLen + coneH / 2)
          );
          group.add(coneMesh);
        }

        return group;
      }

      function update(drill) {
        if (!isPreviewAlive()) init();
        if (!isPreviewAlive()) {
          update2dFallback(drill);
          return;
        }

        clearGroup(panelObjs);
        clearGroup(holeObjs);
        clearGroup(axisObjs);
        clearGroup(seamObjs);
        clearGroup(modelObjs);

        const setupType = Number(document.querySelector('.drill-setup-type-btn.active')?.getAttribute('data-setup') || drill?.setupType || 1);
        const fw = Math.max(1, Number(document.getElementById('drill-frame-w')?.value || drill?.frameW || 100));
        const fh = Math.max(1, Number(document.getElementById('drill-frame-h')?.value || drill?.frameH || 100));
        const fd = (setupType === 1 || setupType === 4)
          ? DRILL_FRAME_PART_THICKNESS_MM
          : Math.max(1, Number(document.getElementById('drill-frame-d')?.value || drill?.frameD || DRILL_FRAME_DEFAULT_DEPTH_MM));
        const U = 0.1;

        // ������
        const panels = buildPanels(setupType, fw, fh, fd, U);
        panels.forEach((p) => { scene.add(p); panelObjs.push(p); });

        // ���� � ��������� � ���� ������ ClodisDrillEngine (��� ���� / CFRN).
        const Eng = window.ClodisDrillEngine;
        const Tmm = 16;
        const mmPerWorldUnit = 1 / U;
        const mock = Eng?.buildEditorMockFrame
          ? Eng.buildEditorMockFrame({
              setupType,
              frameW: fw,
              frameH: fh,
              frameD: fd,
              panelThickMm: Tmm,
              mmPerUnit: U,
            })
          : null;
        const T = Tmm * U;
        const W = fw * U;
        const H = fh * U;
        const D = fd * U;
        const axisLen = Math.max(fw, fh, fd) * U * 0.35;
        let originX = mock ? mock.O.x : 0;
        let originY = mock ? mock.O.y : 0;
        let originZ = mock ? mock.O.z : D / 2;
        if (!mock) {
          switch (setupType) {
            case 2:
              originX = -W / 2 + T;
              originY = -H / 2 + T;
              originZ = 0;
              break;
            case 3:
              originX = -W / 2;
              originY = 0;
              originZ = 0;
              break;
            case 4:
              originX = 0;
              originY = 0;
              originZ = D / 2;
              break;
            default:
              originX = 0;
              originY = 0;
              originZ = D / 2;
          }
        }
        [[1, 0, 0, 0xe74c3c], [0, 1, 0, 0x27ae60], [0, 0, 1, 0x3498db]].forEach(([dx, dy, dz, col]) => {
          const a = makeAxisLine(axisLen, [dx, dy, dz], col);
          a.position.set(originX, originY, originZ);
          scene.add(a);
          axisObjs.push(a);
        });

        if (setupType === 3) {
          makeType3SeamStripes(W, H, D, T).forEach((stripe) => {
            scene.add(stripe);
            seamObjs.push(stripe);
          });
        }

        const showDir = !!document.getElementById('drill-preview-toggle')?.checked;
        const uiSetup = Number(document.querySelector('.drill-setup-type-btn.active')?.getAttribute('data-setup'));
        const activeSt = Number.isFinite(uiSetup) && uiSetup >= 1 && uiSetup <= 4
          ? uiSetup
          : Number(drill?.currentSetupType || drill?.setupType || 3);
        const sk = String(activeSt);
        let holes = (drill?.holesBySetup && Array.isArray(drill.holesBySetup[sk])) ? drill.holesBySetup[sk] : [];
        if (!holes.length && Array.isArray(drill?.holes) && drill.holes.length) holes = drill.holes;

        const O = mock?.O || { x: originX, y: originY, z: originZ };
        const eX = mock?.eX || { x: 1, y: 0, z: 0 };
        const eY = mock?.eY || { x: 0, y: 1, z: 0 };
        const eZ = mock?.eZ || { x: 0, y: 0, z: 1 };
        const placed = Eng?.placeTemplateHoles
          ? Eng.placeTemplateHoles({
              holes,
              O,
              eX,
              eY,
              eZ,
              mmPerWorldUnit,
              setupType: activeSt,
              faceThickMm: Tmm,
              facing: 'inside',
            })
          : null;

        if (placed) {
          placed.forEach((p) => {
            const r = Math.max(0.05, (p.diameter / 2) * U);
            const depth = Math.max(0.1, p.depth * U);
            const dirVec = [p.dir.x, p.dir.y, p.dir.z];
            const holeGroup = makeHoleObj(r, depth, dirVec, showDir);
            holeGroup.position.set(p.entry.x, p.entry.y, p.entry.z);
            scene.add(holeGroup);
            holeObjs.push(holeGroup);
          });
        } else {
          // Fallback ���� ������ ������ ��� �� ��������
          holes.forEach((h) => {
            const diam = parseFloat(h.diameterMm ?? h.diameter) || 0;
            const depthMm = parseFloat(h.depthMm ?? h.depth) || 0;
            if (!diam) return;
            const r = Math.max(0.05, (diam / 2) * U);
            const depth = Math.max(0.1, (depthMm || diam) * U);
            const dirKey = String(h.direction || h.dirKey || '-z').toLowerCase();
            const dirVec = DIR_VECTORS[dirKey] || [0, 0, -1];
            // �����: x/y/z = ����; ������� ����� dir �� depth (makeHoleObj �������� �����).
            const entryX = Number(h.xMm ?? h.x) || 0;
            const entryY = Number(h.yMm ?? h.y) || 0;
            const entryZ = Number(h.zMm ?? h.z) || 0;
            const holeGroup = makeHoleObj(r, depth, dirVec, showDir);
            holeGroup.position.set(
              originX + entryX * U,
              originY - entryY * U,
              originZ - entryZ * U,
            );
            scene.add(holeGroup);
            holeObjs.push(holeGroup);
          });
        }

        const spanX = fw * U;
        const spanY = fh * U;
        const spanZ = fd * U;
        const camDist = Math.max(spanX, spanY, spanZ) * 3.3;
        camera.position.set(originX, originY, originZ + camDist);
        camera.lookAt(originX, originY, originZ);
        if (controls) {
          controls.target.set(originX, originY, originZ);
          controls.update();
        }

        loadPreviewHardwareModel(drill, setupType, originX, originY, originZ, U);
      }

      function resize() {
        if (!renderer || !camera) return;
        const host = document.getElementById('drill-preview-3d');
        if (!host) return;
        const { W, H } = hostSize(host);
        renderer.setSize(W, H);
        camera.aspect = W / H;
        camera.updateProjectionMatrix();
      }

      /** soft � ��� loseContext (��������� init ����� ������ ���������). */
      function destroy(opts = {}) {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }
        try { clearGroup(panelObjs); } catch (_) {}
        try { clearGroup(holeObjs); } catch (_) {}
        try { clearGroup(seamObjs); } catch (_) {}
        try { clearGroup(modelObjs); } catch (_) {}
        try { clearGroup(axisObjs); } catch (_) {}
        try { controls?.dispose?.(); } catch (_) {}
        try {
          const el = renderer?.domElement;
          // �� �������� loseContext: ����� ���� Chrome ����� �� ��� ������� ����� WebGL
          // (�Error creating WebGL context�) �� ������� ����������� ��������.
          if (el?.parentNode) el.parentNode.removeChild(el);
          renderer?.dispose?.();
        } catch (_) {}
        renderer = null;
        scene = null;
        camera = null;
        controls = null;
        initialized = false;
      }

      return {
        init,
        update,
        resize,
        destroy,
        applyHardwareDisplayMode: applyDrillPreviewHardwareDisplayMode,
      };
    })();

