              return `<option value="${id.replace(/"/g, '&quot;')}">${name.replace(/</g, '&lt;')}</option>`;
            })
          : [];
        select.innerHTML = '<option value="">(�� �������)</option>' + options.join('');
      } catch (e) {
        console.warn('⚠️ �� ������� ��������� ��������� ������� ��� �����:', e);
      }
    }

