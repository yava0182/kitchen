      if (variants.length <= 1) return base;
      const th = variant?.thickness;
      if (th != null && th !== '') {
        const thStr = String(th).replace('.', ',');
        if (base.includes(thStr) || base.includes(String(th))) return base;
        return base + ' � ' + thStr + ' ��';
      }
      return base + ' (������� ' + (variantIndex + 1) + ')';
