         * ����� ��� ��������� ������ � ������ ������. ���� ��L �� ����� / ������ ��.
         */
        function _fastenerSizeMmFromCabinetModelItem(it) {
          const name = String(it?.name || it?.data?.name || it?.params?.name || '').trim();
          const dim = name.match(/(\d+(?:[.,]\d+)?)\s*[x�\*�]\s*(\d+(?:[.,]\d+)?)/i);
          if (dim) {
            const a = Math.max(1, parseFloat(String(dim[1]).replace(',', '.')) || 7);
            const b = Math.max(1, parseFloat(String(dim[2]).replace(',', '.')) || 50);
            const cross = Math.min(a, b);
            const len = Math.max(a, b);
            return { w: cross, h: len, d: cross, name: name || '�����' };
          }
          const d = it?.data && typeof it.data === 'object' ? it.data : {};
          const p = it?.params || d.params || d || {};
          let w = Number(p.width ?? d.width ?? it?.width) || 0;
          let h = Number(p.height ?? d.height ?? it?.height) || 0;
          let depth = Number(p.depth ?? d.depth ?? it?.depth) || 0;
          // ������ �������� ������ / ������ � �� ������ ������
          if (w >= 100 || h >= 100 || depth >= 100 || w <= 0 || h <= 0 || depth <= 0) {
            return { w: 7, h: 50, d: 7, name: name || '�����' };
          }
          return { w, h, d: depth, name: name || '�����' };
