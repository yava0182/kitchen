            return;
          }
          node.nodeData.spec = node.nodeData.spec || {};
          const facadeH = Math.max(100, _computeFacadeHeightMm(node));
          const facadeW = Math.max(100, _computeFacadeWidthMm(node));
          let ys = [];
          let drillTplId = '';
          let schemeName = '';
          let schemeIdStored = '';
          let seamEdge = 'left';
          let facadeThickness = 16;
          if (selected.kind === 'hinge_layout') {
            const hs = ensureHingeLayoutScheme(selected.data || {});
            seamEdge = hs.seamEdge || 'left';
            facadeThickness = hs.facadeThickness || 16;
            const seamLen = (seamEdge === 'top' || seamEdge === 'bottom') ? facadeW : facadeH;
            ys = Array.from(new Set(calcHingeLayoutPositions(hs, seamLen).map((p) => Math.max(0, Math.min(seamLen, Math.round(Number(p) || 0)))))).sort((a, b) => a - b);
            drillTplId = String(hs.drillTemplateId || 0);
            schemeName = String(hs.name || '');
            schemeIdStored = 'hl:' + (Number(hs.id) || 0);
          } else {
            const ds = selected.data;
            const calc = calcSchemePositions(ds, facadeH);
            ys = Array.from(new Set((calc?.positions || []).map((p) => Math.max(0, Math.min(facadeH, Math.round(Number(p) || 0)))))).sort((a, b) => a - b);
            drillTplId = String(ds.templateId || 0);
            schemeName = String(ds.name || '');
            schemeIdStored = 'ds:' + (Number(ds.id) || 0);
          }
          if (!ys.length) {
            if (info) info.textContent = '\u0421\u0445\u0435\u043C\u0430 "' + schemeName + '" \u043D\u0435 \u0434\u0430\u043B\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u0439 \u0434\u043B\u044F \u0444\u0430\u0441\u0430\u0434\u0430 ' + Math.round(facadeH) + ' \u043C\u043C.';
            return;
          }

          node.nodeData.spec.hinge_scheme = {
            schemeId: schemeIdStored,
            schemeName,
            drillTemplateId: drillTplId,
            seamEdge,
            source: selected.kind === 'hinge_layout' ? 'clodis_hinge_layout_schemes_v1' : 'clodis_drill_schemes_v1',
            hinge_instances: ys.map((y) => ({ y, drillTemplateId: drillTplId })),
          };

          const facadeHostSection = _findNearestSectionAncestor(node);
          if (facadeHostSection) {
            const chWrap = facadeHostSection.querySelector(':scope > .tree-node-children');
            const direct = chWrap ? Array.from(chWrap.children).filter((el) => el.classList?.contains('constructor-tree-node')) : [];
            const hingeRoot = direct.find((el) => /\u043F\u0435\u0442\u043B/i.test(String(el.nodeData?.name || el.getAttribute('data-node-name') || '')));
            let baseHingeTemplate = null;
            if (hingeRoot) {
              const hingeRootData = _extractNodeTreeData(hingeRoot);
              if (Array.isArray(hingeRootData?.children) && hingeRootData.children.length > 0) {
                baseHingeTemplate = hingeRootData.children[0];
              }
            }
            if (hingeRoot?.parentElement) hingeRoot.parentElement.removeChild(hingeRoot);
            node.__cldBaseHingeTemplate = baseHingeTemplate || null;
          }

          const hingeChildren = ys
            .map((yy, i) => _buildSingleHingeTree(i, yy, seamEdge, facadeW, facadeH, node.__cldBaseHingeTemplate || null))
            .filter(Boolean);
          if (!hingeChildren.length) {
            if (info) info.textContent = '�� ������ ������ ����� ��� ����������� (������� ��� �������� �����������). ������� ��������/��������� �����-��������.';
            try { delete node.__cldBaseHingeTemplate; } catch (_) {}
            return;
          }

          const hingeRootData = {
            type: 'section',
            name: '\u041F\u0435\u0442\u043B\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043D\u044B\u0435',
            size: { x: 's:x', y: 's:y', z: 's:z' },
            position: { x: 0, y: 0, z: 0 },
            anchor: { x: -1, y: -1, z: -1 },
            spec: { orientation: 'f', visual_only: true },
            children: hingeChildren,
          };
          try { delete node.__cldBaseHingeTemplate; } catch (_) {}

          const parentForHinge = facadeHostSection || _findNearestSectionAncestor(node);
          if (parentForHinge) {
            _createNodeTreeFromData(hingeRootData, parentForHinge);
          }

          syncTreePaths();
          try { saveConstructorNodeData(node); } catch (_) {}
          try { if (typeof window.__ppPostModuleToIframe === 'function') window.__ppPostModuleToIframe(); } catch (_) {}
          if (info) info.textContent = '\u0421\u0445\u0435\u043C\u0430: ' + schemeName + '. \u041F\u0435\u0442\u0435\u043B\u044C: ' + ys.length + ', \u0444\u0430\u0441\u0430\u0434: ' + Math.round(facadeH) + ' \u043C\u043C | \u0441\u0442\u044B\u043A: ' + seamEdge + '.';
        }

