        const arr = raw ? JSON.parse(raw) : null;
        return Array.isArray(arr) && arr.length ? arr : JSON.parse(JSON.stringify(DRILL_ITEM_TYPES_DEFAULT));
      } catch { return JSON.parse(JSON.stringify(DRILL_ITEM_TYPES_DEFAULT)); }
    };
    const saveDrillItemTypes = (arr) => { try { localStorage.setItem(DRILL_ITEM_TYPES_KEY, JSON.stringify(arr || [])); } catch {} };
    const nextDrillItemTypeId = (arr) => ((arr || []).reduce((m, x) => Math.max(m, Number(x?.id) || 0), 0) + 1);
    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    /** ���� 1 � 4: � ����� ������ ���; �� ��� ��������� ������ ����������� 16 �� (��� ���� �� ���������). ���� 2 � 3 � 100 �� �� ���������. */
    const DRILL_FRAME_PART_THICKNESS_MM = 16;
    const DRILL_FRAME_DEFAULT_DEPTH_MM = 100;

    function ensureDrill(obj = {}) {
      let cats = obj.categories;
      if (!Array.isArray(cats)) {
        const legacy = String(obj.category || '').trim();
        cats = legacy ? [legacy] : [];
      }
      const sRaw = Number(obj.setupType);
      const st = Number.isFinite(sRaw) && sRaw >= 1 && sRaw <= 4 ? sRaw : 3;
      const dRaw = Number(obj.frameD);
      const frameD = (st === 1 || st === 4)
        ? DRILL_FRAME_PART_THICKNESS_MM
        : (Number.isFinite(dRaw) && dRaw > 0 ? dRaw : DRILL_FRAME_DEFAULT_DEPTH_MM);
      return {
        id: Number(obj.id) || 0,
        name: String(obj.name || '������'),
        article: String(obj.article || ''),
        categories: cats,
        category: cats.join(', '),
        icon: String(obj.icon || ''),
        order: Number(obj.order) || 10000,
        active: !!obj.active,
        showSpec: !!obj.showSpec,
        calcType: String(obj.calcType || 'piece'),
        priceMode: String(obj.priceMode || 'manual'),
        price: Number(obj.price) || 0,
        setupType: st,
        currentSetupType: (function () {
          const c = Number(obj.currentSetupType);
          return Number.isFinite(c) && c >= 1 && c <= 4 ? c : st;
        })(),
        frameW: Number(obj.frameW) || 100,
        frameH: Number(obj.frameH) || 100,
        frameD,
        furnitureType: String(obj.furnitureType || ''),
        cabinetModelId: Number(obj.cabinetModelId) || 0,
        cabinetModelName: String(obj.cabinetModelName || ''),
        // L-����� �����: ������ ����; 0 → fallback cabinetModelId (legacy #5).
        corpusModelId: Number(obj.corpusModelId) || 0,
        corpusModelName: String(obj.corpusModelName || ''),
        facadeModelId: Number(obj.facadeModelId) || 0,
        facadeModelName: String(obj.facadeModelName || ''),
        jointModelVisualOffsetMm: normalizeJointModelVisualOffsetMm(obj.jointModelVisualOffsetMm),
        facadeModelVisualOffsetMm: normalizeJointModelVisualOffsetMm(obj.facadeModelVisualOffsetMm),
        jointModelVisualRotDeg: normalizeJointModelVisualRotDeg(obj.jointModelVisualRotDeg),
        facadeModelVisualRotDeg: normalizeJointModelVisualRotDeg(obj.facadeModelVisualRotDeg),
        // Per-setupType holes (1�4). ������ ���� = [] (��� � ����), ��� ���������� ������ � ������ ����.
        ...(() => {
          const mapOne = (h, idx) => {
            const through = !!h.through;
            const defTech = '��������������� ���������';
            const defThrough = '�������� ���. ���������';
            let name = String(h.name || (through ? defThrough : defTech));
            if (through && name === defTech) name = defThrough;
            if (!through && name === defThrough) name = defTech;
            return {
              id: Number(h.id) || (idx + 1),
              name,
              diameter: h.diameter != null && h.diameter !== '' ? Number(h.diameter) : '',
              depth:    h.depth    != null && h.depth    !== '' ? Number(h.depth)    : '',
              direction: (function(d) {
                const s = String(d || '-z').trim().toLowerCase();
                return ['x', '-x', 'y', '-y', 'z', '-z'].includes(s) ? s : '-z';
              })(h.direction),
              x: Number(h.x) || 0,
              y: Number(h.y) || 0,
              z: Number(h.z) || 0,
              // ����� ��������� ��� � ��: ���� ��������� � ������� ���������.
              coordBase: (function(v) {
                const s = String(v || 'auto').trim().toLowerCase();
                return ['auto', 'from_seam', 'from_face'].includes(s) ? s : 'auto';
              })(h.coordBase),
              mountSide: (function(v) {
                const s = String(v || 'auto').trim().toLowerCase();
                return ['auto', 'face', 'edge'].includes(s) ? s : 'auto';
              })(h.mountSide),
              // L (��� 2): �� ����� ������ ������� ����� ��������� (�� mountSide face/edge).
              hostPanel: (function(v) {
                const s = String(v || 'auto').trim().toLowerCase();
                if (['vertical', 'vert', 'v', 'facade'].includes(s)) return 'vertical';
                if (['horizontal', 'horiz', 'h', 'corpus', 'body'].includes(s)) return 'horizontal';
                return 'auto';
              })(h.hostPanel ?? h.host_panel),
              through,
            };
          };
          const normalizeList = (arr) => (Array.isArray(arr) && arr.length ? arr.map(mapOne) : []);
          const isPristinePlaceholder = (h) => {
            if (!h || h.through) return false;
            const d = h.diameter;
            const dp = h.depth;
            if (d !== '' && d != null && String(d).trim() !== '' && Number(d) > 0) return false;
            if (dp !== '' && dp != null && String(dp).trim() !== '' && Number(dp) > 0) return false;
            if (Number(h.x) || Number(h.y) || Number(h.z)) return false;
            return true;
          };
          const collapsePlaceholderOnly = (arr) => {
            const n = normalizeList(arr);
            if (n.length === 1 && isPristinePlaceholder(n[0])) return [];
            return n;
          };

          const bySetup = { '1': [], '2': [], '3': [], '4': [] };
          const inc = obj.holesBySetup;
          if (inc && typeof inc === 'object') {
            for (let i = 1; i <= 4; i++) {
              const k = String(i);
              bySetup[k] = collapsePlaceholderOnly(inc[k]);
            }
          }
          let any = [1, 2, 3, 4].some((i) => bySetup[String(i)].length > 0);
          const legacy = collapsePlaceholderOnly(obj.holes);
          if (!any && legacy.length) {
            bySetup[String(st)] = legacy;
            any = true;
          }
          if (!any) {
            bySetup[String(st)] = [{
              id: 1, name: '��������������� ���������', diameter: '', depth: '', direction: '-z', x: 0, y: 0, z: 0, coordBase: 'auto', mountSide: 'auto', hostPanel: 'auto', through: false
            }];
          }
          const flat = JSON.parse(JSON.stringify(bySetup[String(st)]));
          return {
            holesBySetup: bySetup,
            holes: flat,
            currentSetupType: st,
          };
        })(),
      };
    }

