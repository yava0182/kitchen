            const px = parseFloat(String(ps.x || ''));
            const py = parseFloat(String(ps.y || ''));
            const pz = parseFloat(String(ps.z || ''));
            if (Number.isFinite(px)) sw = px;
            if (Number.isFinite(py)) sh = py;
