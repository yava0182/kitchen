        function _computeFacadeHeightMm(facadeNode) {
          const nd = facadeNode?.nodeData || {};
          const yRaw = nd.size?.y;
          const hostSection = _findNearestSectionAncestor(facadeNode);
          const hostY = Number(hostSection?.nodeData?.size?.y);
          const baseY = Number.isFinite(hostY) && hostY > 0
            ? hostY
            : Number(rootModule?.nodeData?.__cldAuthorSizeMm?.y) || 400;
          const yEval = _evalSizeExprForHinge(yRaw, baseY);
          return Number.isFinite(yEval) && yEval > 0 ? yEval : baseY;
        }

        function _computeFacadeWidthMm(facadeNode) {
          const nd = facadeNode?.nodeData || {};
          const xRaw = nd.size?.x;
          const hostSection = _findNearestSectionAncestor(facadeNode);
          const hostX = Number(hostSection?.nodeData?.size?.x);
          const baseX = Number.isFinite(hostX) && hostX > 0
            ? hostX
            : Number(rootModule?.nodeData?.__cldAuthorSizeMm?.x) || 400;
          const xEval = _evalSizeExprForHinge(xRaw, baseX);
          return Number.isFinite(xEval) && xEval > 0 ? xEval : baseX;
        }

        function _createNodeTreeFromData(data, parent) {
          if (!data) return null;
          const rawType = String(data.type || '').toLowerCase().trim();
          const isDetail = rawType === 'detail' || rawType === 'model' || rawType === 'furniture' || rawType === 'module' || rawType === 'animator';
          const nodeType = isDetail ? 'detail' : 'section';
          const nd = createConstructorTreeNode(nodeType, parent);
          if (data.name) {
            nd.setAttribute('data-node-name', data.name);
            nd.nodeData.name = data.name;
            const nameEl = nd.querySelector('.tree-node-name');
            if (nameEl) nameEl.textContent = data.name;
          }
          const ot =
            data.originalType ||
            (rawType === 'model' || rawType === 'furniture' || rawType === 'animator' ? rawType : '');
          if (ot) {
            nd.nodeData.originalType = ot;
            nd.setAttribute('data-original-type', ot);
          }
          if (data.size) {
            nd.nodeData.size = {
              x: data.size.x !== undefined ? data.size.x : '',
              y: data.size.y !== undefined ? data.size.y : '',
              z: data.size.z !== undefined ? data.size.z : '',
            };
          }
          nd.nodeData.position = data.position || data.pos || { x: '0', y: '0', z: '0' };
          nd.nodeData.anchor = data.anchor || data.pivot || { x: -1, y: -1, z: -1 };
          nd.nodeData.rotation = data.rotation || data.rot || { x: '0', y: '0', z: '0' };
          if (data.c_rot && typeof data.c_rot === 'object') nd.nodeData.c_rot = { ...data.c_rot };
          if (data.spec && typeof data.spec === 'object') nd.nodeData.spec = { ...data.spec };
          if (data.modelId != null) nd.nodeData.modelId = String(data.modelId);
          if (data.helpers_visible != null) nd.nodeData.helpers_visible = Number(data.helpers_visible) ? 1 : 0;
          if (data.fromJointScheme) {
            nd.nodeData.fromJointScheme = 1;
            if (data.jointIdx != null) nd.nodeData.jointIdx = Number(data.jointIdx);
            if (Number(data.schemeId) > 0) nd.nodeData.schemeId = Number(data.schemeId);
            if (data.contactId) nd.nodeData.contactId = String(data.contactId);
            if (data.neighborName) nd.nodeData.neighborName = String(data.neighborName);
            if (data.seamPosMm != null) nd.nodeData.seamPosMm = Number(data.seamPosMm);
            if (data.frameIndex != null) nd.nodeData.frameIndex = Number(data.frameIndex);
          }
          addTreeNodeToParent(nd, parent);
          if (Array.isArray(data.children)) {
            data.children.forEach((ch) => _createNodeTreeFromData(ch, nd));
          }
          return nd;
        }

        function _extractNodeTreeData(nodeEl) {
          if (!nodeEl || !nodeEl.classList?.contains('constructor-tree-node')) return null;
          const nd = nodeEl.nodeData || {};
          const nodeTypeAttr = String(nodeEl.getAttribute('data-node-type') || '').toLowerCase();
          const originalType = String(nd.originalType || nodeEl.getAttribute('data-original-type') || '').toLowerCase();
          const outType = nodeTypeAttr === 'detail' ? (originalType || 'detail') : 'section';
          const out = {
            type: outType,
            name: nd.name || nodeEl.getAttribute('data-node-name') || '',
            size: JSON.parse(JSON.stringify(nd.size || { x: '', y: '', z: '' })),
            position: JSON.parse(JSON.stringify(nd.position || { x: 0, y: 0, z: 0 })),
            anchor: JSON.parse(JSON.stringify(nd.anchor || { x: -1, y: -1, z: -1 })),
            rotation: JSON.parse(JSON.stringify(nd.rotation || { x: 0, y: 0, z: 0 })),
            spec: JSON.parse(JSON.stringify(nd.spec || {})),
            children: [],
          };
          if (originalType) out.originalType = originalType;
          const chWrap = nodeEl.querySelector(':scope > .tree-node-children');
          const direct = chWrap ? Array.from(chWrap.children).filter((el) => el.classList?.contains('constructor-tree-node')) : [];
          direct.forEach((ch) => {
            const child = _extractNodeTreeData(ch);
            if (child) out.children.push(child);
          });
          return out;
        }

        function _buildSingleHingeTree(index, yPosMm, seamEdge, facadeW, facadeH, baseTemplate = null) {
          const W = Number(facadeW) || 400;
          const H = Number(facadeH) || 600;
          const tpl = baseTemplate && typeof baseTemplate === 'object'
            ? JSON.parse(JSON.stringify(baseTemplate))
            : null;
          if (!tpl) return null;
          const hW = Number(tpl?.size?.x) || 50;
          const hH = Number(tpl?.size?.y) || 67;
          let sx, sy;
          switch (seamEdge) {
            case 'right':  sx = W - hW; sy = yPosMm; break;
            case 'top':    sx = yPosMm; sy = H - hH; break;
            case 'bottom': sx = yPosMm; sy = 0; break;
            default:       sx = 0;      sy = yPosMm; break;
          }
          tpl.name = tpl.name || ('����� ' + (index + 1));
          tpl.position = { x: sx, y: sy, z: 0 };
          tpl.anchor = tpl.anchor || { x: -1, y: -1, z: -1 };
          tpl.rotation = tpl.rotation || { x: 0, y: 0, z: 0 };
          return tpl;
        }

        function _applyHingeSchemeToSelectedFacade() {
          const node = currentSelectedNode;
          if (!node || node.getAttribute('data-node-type') !== 'detail' || String(node.nodeData?.originalType || '').toLowerCase() !== 'facade') {
            alert('\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0443\u0437\u0435\u043B \u0444\u0430\u0441\u0430\u0434\u0430 \u0432 \u0434\u0435\u0440\u0435\u0432\u0435.');
