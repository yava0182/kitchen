        typeKeys.forEach((tKey) => {
          const grp = prices[tKey] || {};
          const row = grp[matId];
          let price = '';
          if (row && typeof row === 'object') {
            price = row.price != null ? String(row.price) : '';
          } else if (typeof row === 'number') {
