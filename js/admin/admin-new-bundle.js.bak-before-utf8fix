      s += bmDimH(seamX - h1zone, seamX, vy - 10, 'H1', true);
      s += bmDimH(eccX - eccR, eccX + eccR, vy - 10, 'D', true);
      // Right: Y (center → bottom shelf)
      s += bmDimV(edgeCy, vpY + et, seamX + pw + 14, 'Y', false);
