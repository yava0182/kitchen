        function normalizeModels3dPropsCatalogItems(data) {
          let raw = Array.isArray(data) ? data : data && data.items != null ? data.items : [];
          if (!Array.isArray(raw)) raw = Object.values(raw || {});
          return (raw || [])
            .filter(Boolean)
            .map((it) => {
              const d = it.data || {};
              const p = it.params || d.params || d || {};
              return {
                id: String(it.id ?? it.ID ?? ''),
                name: String(it.name || d.name || p.name || '������'),
                code: String(it.code || d.code || p.code || it.article || d.article || ''),
              };
            })
            .filter((it) => it.id);
        }

        async function loadModels3dCatalogForProperties(forceReload) {
          if (_models3dPropsCatalogCache && _models3dPropsCatalogCache.length && !forceReload) {
            return _models3dPropsCatalogCache;
          }
          try {
            const res = await fetch(
              '/api/catalog/items_get/' + encodeURIComponent(CLD_MODELS3D_PROPS_CATALOG_KEY) + '?t=' + Date.now(),
              { cache: 'no-cache' }
            );
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            _models3dPropsCatalogCache = normalizeModels3dPropsCatalogItems(data);
          } catch (e) {
            console.warn('[CLD][props][models3d] load error', e);
            _models3dPropsCatalogCache = [];
          }
          return _models3dPropsCatalogCache;
        }

