        function _rebindJointSchemesWithContacts(node, contacts) {
          if (!node?.nodeData || !Array.isArray(node.nodeData.jointSchemes)) return false;
          const list = node.nodeData.jointSchemes;
          if (!list.length || !Array.isArray(contacts) || !contacts.length) return false;
          const sortedC = contacts
            .slice()
            .sort((a, b) =>
              String(a.neighborName || '').localeCompare(String(b.neighborName || ''), 'ru'),
            );
          const byScheme = new Map();
          list.forEach((j, idx) => {
            const sid = Number(j.schemeId) || 0;
            if (!byScheme.has(sid)) byScheme.set(sid, []);
            byScheme.get(sid).push({ j, idx });
          });
          let changed = false;
          for (const [, items] of byScheme) {
            const needRebind = items.some((it) => !it.j.contactId || !it.j.neighborName);
            if (!needRebind) continue;
            items.sort((a, b) => Number(a.j.jointIdx) - Number(b.j.jointIdx));
            items.forEach((it, i) => {
              const c = sortedC[i];
              if (!c) return;
              if (!it.j.contactId) {
                it.j.contactId = String(c.id);
                changed = true;
              }
              if (!it.j.neighborName) {
                it.j.neighborName = c.neighborName || '';
                changed = true;
              }
              if (!it.j.conditionKey && c.conditionKey) {
                it.j.conditionKey = String(c.conditionKey);
                changed = true;
              }
              if (!it.j.hostFaceType && c.hostFaceType) {
