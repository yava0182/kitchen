      } catch (e) {}
      if (q) {
        out = out.filter((it) => {
          const name = (it?.name || '').toString().toLowerCase();
          const art = (it?.article || '').toString().toLowerCase();
          const id = String(it?.id ?? '');
          if (name.includes(q) || art.includes(q) || id.includes(q)) return true;
          const variants = getEdgeVariantsFromCatalogItem(it);
          return variants.some((v) => {
            const vn = (v?.name || '').toString().toLowerCase();
            const th = v?.thickness != null ? String(v.thickness).toLowerCase() : '';
            return vn.includes(q) || th.includes(q);
