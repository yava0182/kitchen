      s += `<line x1="${x1}" y1="${yPart}" x2="${x1}" y2="${yLine}" stroke="${_DIM}" stroke-width="0.3"/>`;
      s += `<line x1="${x2}" y1="${yPart}" x2="${x2}" y2="${yLine}" stroke="${_DIM}" stroke-width="0.3"/>`;
      s += `<line x1="${x1}" y1="${yLine}" x2="${x2}" y2="${yLine}" stroke="${_DIM}" stroke-width="0.5" marker-start="url(#bmArr)" marker-end="url(#bmArr)"/>`;
      s += `<text x="${tx}" y="${ty}" text-anchor="middle" font-size="${_FS}" font-family="Arial,sans-serif" fill="${_DIM}" font-style="italic">${label}</text>`;
      return s;
    }

    // ---- SVG-������� ��� ������� ���� (1:1 �� ��) ----
    function bmBolt(x, y, w, h) {
      let s = `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="#888" stroke="#000" stroke-width="0.4" rx="0.5"/>`;
      const step = 2;
      for (let ty = y + step; ty < y + h - 0.5; ty += step) {
        s += `<line x1="${x + 0.3}" y1="${ty}" x2="${x + w - 0.3}" y2="${ty}" stroke="#666" stroke-width="0.2"/>`;
      }
      return s;
    }
    function bmBoltHead(cx, cy, rw, rh) {
      return `<ellipse cx="${cx}" cy="${cy}" rx="${rw}" ry="${rh || rw}" fill="#aaa" stroke="#000" stroke-width="0.4"/>
        <line x1="${cx - rw * 0.5}" y1="${cy}" x2="${cx + rw * 0.5}" y2="${cy}" stroke="#000" stroke-width="0.3"/>`;
    }

