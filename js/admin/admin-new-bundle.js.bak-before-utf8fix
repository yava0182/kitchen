          const res = await fetch('/api/catalog/items_get/cabinet_model?t=' + Date.now(), { cache: 'no-cache' });
          if (!res.ok) return '';
          const data = await res.json();
          let raw = Array.isArray(data) ? data : data?.items;
          if (!Array.isArray(raw) && raw && typeof raw === 'object') raw = Object.values(raw);
          const item = (raw || []).find((it) => Number(it?.id) === id);
          if (!item) return '';
          const models = item?.data?.params?.models || item?.params?.models || [];
          const path = String(models?.[0]?.model || '').trim();
          if (!path) return '';
          if (/^https?:\/\//i.test(path)) return path;
          return path.startsWith('/') ? path : '/' + path;
        } catch (e) {
          console.warn('[DrillPreview3D] cabinet_model url', e);
          return '';
        }
      }

      /** GLB �� jsm-loader → ���� global THREE (admin three.min.js). �������� � ��������� ���������. */
      function bakeModelRootToGlobalTHREE(src) {
        const out = new THREE.Group();
        if (!src) return out;
        try { src.updateMatrixWorld(true); } catch (_) {}
        src.traverse((o) => {
          if (!o?.geometry?.attributes?.position) return;
          let srcGeo = o.geometry;
          try {
            if (srcGeo.index) srcGeo = srcGeo.toNonIndexed();
          } catch (_) {}
          const posAttr = srcGeo.attributes?.position;
          if (!posAttr || !posAttr.count) return;
          const count = posAttr.count;
          const positions = new Float32Array(count * 3);
          // getX/Y/Z � ��������� � ��� InterleavedBufferAttribute (slice() ������ ��� → ������ ��� ����� pivot).
          for (let i = 0; i < count; i++) {
            positions[i * 3] = posAttr.getX(i);
            positions[i * 3 + 1] = posAttr.getY(i);
            positions[i * 3 + 2] = posAttr.getZ(i);
          }
          const geo = new THREE.BufferGeometry();
          geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
          try { geo.computeVertexNormals(); } catch (_) {}
          const srcMat = Array.isArray(o.material) ? o.material[0] : o.material;
          let colorHex = 0x6b7280;
          let metalness = 0.35;
          let roughness = 0.45;
          try {
            if (srcMat?.color && typeof srcMat.color.getHex === 'function') {
              colorHex = srcMat.color.getHex();
            } else if (typeof srcMat?.color === 'number') {
              colorHex = srcMat.color;
            }
            if (Number.isFinite(Number(srcMat?.metalness))) metalness = Number(srcMat.metalness);
            if (Number.isFinite(Number(srcMat?.roughness))) roughness = Number(srcMat.roughness);
          } catch (_) {}
          // MeshStandardMaterial: ������ � �������� 3D (�� ������� MeshBasic �����).
          const MatCtor = THREE.MeshStandardMaterial || THREE.MeshBasicMaterial;
          const matOpts = {
            color: colorHex,
            side: THREE.DoubleSide,
            depthTest: true,
            depthWrite: true,
          };
          if (MatCtor === THREE.MeshStandardMaterial) {
            matOpts.metalness = metalness;
            matOpts.roughness = roughness;
          }
          const mat = new MatCtor(matOpts);
          const mesh = new THREE.Mesh(geo, mat);
          mesh.name = String(o.name || '');
          try {
            const el = o.matrixWorld?.elements;
            if (el && el.length >= 16) {
              mesh.applyMatrix4(new THREE.Matrix4().fromArray(Array.from(el)));
            }
          } catch (_) {}
          out.add(mesh);
        });
        return out;
      }

      async function probeDrillPreviewModelUrl(url) {
        if (!url) return 'URL ������';
        try {
          const r = await fetch(url, { method: 'GET', cache: 'no-store' });
          if (!r.ok) return `HTTP ${r.status}`;
          const ct = String(r.headers.get('content-type') || '').toLowerCase();
          if (ct.includes('text/html')) return '404 (HTML ������ GLB)';
          return '';
        } catch (e) {
          return String(e?.message || e || '����');
        }
      }

