# AI Pilot — ключ НЕ коммитить. Скопируйте в .env в корне Configurator-Clodis-ThreeJS-7
# (server.js пока не грузит dotenv автоматически: задайте в ОС / перед npm start)

# Общий ключ (OpenAI / Yandex / compatible)
AI_PILOT_API_KEY=

# Для YandexGPT (folder id каталога в Yandex Cloud)
AI_PILOT_FOLDER_ID=

